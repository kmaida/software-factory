<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Factory dispatcher on the Mac mini. Install: see docs/mini.md (replace __HOME__ with the
       softwarefactory user's home, then launchctl bootstrap gui/$(id -u)). One sweep every 30 minutes
       and one at load; the dispatch skill is idempotent so an overlap wastes a sweep, nothing more.
       The sweep runs under keycard agent exec: GH_TOKEN and LINEAR_TOKEN are brokered in from the zone's
       resources, so a missing consent or a rejected token is a non-zero "sweep exit" with the reason in
       dispatch.err.log, never a sweep that silently reports nothing to do.
       Paths stay out of ~/Documents on purpose: launchd processes touching it hang on a privacy prompt or
       are refused (docs/mini.md, "Not under ~/Documents"). The exit status is captured before the closing
       echo: "$(date)" inside that echo would otherwise overwrite $? with date's own status. -->
  <key>Label</key>
  <string>ai.keycard.factory.dispatch</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-c</string>
    <string>echo "=== $(date -u +%FT%TZ) sweep start"; keycard agent exec --config "$HOME/Development/factory/keycard.toml" --zone "$KEYCARD_ZONE" -- "$HOME/Development/factory/scripts/dispatch.sh"; rc=$?; echo "=== $(date -u +%FT%TZ) sweep exit $rc"</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>KEYCARD_ZONE</key>
    <string>1jgewf106fax3oaf70vyykwj2i</string>
    <!-- No login shell under launchd: claude, keycard, gh, node (fnm default) must all be on this PATH. -->
    <key>PATH</key>
    <string>__HOME__/.local/bin:__HOME__/.local/share/fnm/aliases/default/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>__HOME__</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__HOME__/.factory</string>

  <key>StartInterval</key>
  <integer>1800</integer>
  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.factory/logs/dispatch.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.factory/logs/dispatch.err.log</string>

  <!-- Keep the sweep off the efficiency cores and don't let launchd batch it. -->
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>Nice</key>
  <integer>0</integer>
</dict>
</plist>
