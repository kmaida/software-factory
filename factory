  done < <(jq -r '.[] | "\(.task_id) \(.original)"' <<< "$revised")   # the original first: a revised task is never queued without it (was_revised reads a stop between the two as not revised)
  trap 'exit 130' INT TERM
  jq -r '.[] | "  added \(.task_id): depends_on + \(.depends_on|join(" "))"' <<< "$added"
  jq -r '.[] | "  refused \(.task_id): the answer dropped \(.dropped|join(" ")), which stays"' <<< "$refused"
  jq -r '.[] | "  held \(.task_id) (\(.kind)): \(.reason)"' <<< "$held"
  jq -r '.[] | "  revised \(.task_id) (\(.kind)): \(.reason)"' <<< "$revised"
  log "deep lint applied: $(jq length <<< "$added") addition(s), $(jq length <<< "$held") hold(s), $(jq length <<< "$refused") refused drop(s)"
  echo "deep lint: $(jq length <<< "$added") task(s) gained depends_on, $(jq length <<< "$held") held$([ "$revised" = '[]' ] || echo ", $(jq length <<< "$revised") revised")"
  manifest_set '.deep_lint.result = "applied"'
}

# What a dependency is to the task about to run, from the queue dir and GitHub, printed as "<state> [reason]":
#   merged    a merged PR from factory/<id> (or a -r<N>/-i<N> head of it) into the dependent's base branch, and no merged PR titled
#             `Revert "factory: <id>"` (the revert button's exact title). Dry runs (a local repo) have no PRs: the run's final_sha is an
#             ancestor of the base branch.
#   queued    a run of it is still in the queue (a retry, a requeue, an infra failure left for tomorrow)
#   open      a PR exists, or (dry run) the branch is pushed and not merged
#   unknown   GitHub or the run record could not be asked (HTTP error, no token, a pruned runs/ dir, a base that cannot be fetched):
#             a wait, said as such, never a verdict either way
#   reverted  merged, then reverted
#   dead      none of the above: failed with nothing queued, held for a human by deep lint (its reason said), closed unmerged, or merged
#             into another branch than the base
# Candidates are the done/ files whose id normalises to the base id and whose repo is the dependent's. Precedence: merged as soon as one
# candidate is, else queued, open, unknown, reverted, dead. GitHub is the truth for merged; done/ only says a PR was opened.
dep_state() {  # dep_state <queue-dir> <base id> <repo as in the task> <base_branch>
  d=$1 bid=$2 bb=$4; repo_norm "$3" || { echo "unknown the task's repo has an unknown form"; return; }; drepo=$repo durl=$repo_url
  anyq= anyopen= anyrev= unk= elsewhere=
  for g in "$d"/*.json; do [ -e "$g" ] || break
    [ "$(base_id "$(jq -r '.task_id // empty' "$g" 2>/dev/null || true)")" = "$bid" ] || continue
    [ "$(repo_norm "$(jq -r '.repo // empty' "$g" 2>/dev/null || true)" 2>/dev/null && printf '%s' "$repo" || true)" = "$drepo" ] || continue
    anyq=1
  done
  for g in "$d"/done/*.json; do [ -e "$g" ] || break
    cid=$(jq -r '.task_id // empty' "$g" 2>/dev/null || true); [ "$(base_id "$cid")" = "$bid" ] || continue
    [ "$(repo_norm "$(jq -r '.repo // empty' "$g" 2>/dev/null || true)" 2>/dev/null && printf '%s' "$repo" || true)" = "$drepo" ] || continue
    case "$durl" in
      https://github.com/*)
        tok=$(dep_token "$drepo" "$durl") || tok=; [ -n "$tok" ] || { unk="no GitHub token for $drepo"; continue; }
        resp=$(printf 'header = "Authorization: Bearer %s"\n' "$tok" | curl -sS -m 30 -K - -w '\n%{http_code}' -H "Accept: application/vnd.github+json" \
                 "https://api.github.com/repos/$drepo/pulls?state=all&head=${drepo%%/*}:factory/$cid") || resp=$'\n000'
        code=${resp##*$'\n'}; body=${resp%$'\n'*}
        st=$(printf '%s' "$body" | jq -r --arg bb "$bb" 'if type!="array" then "ERR" elif any(.[]; .merged_at!=null and .base.ref==$bb) then "merged"
              elif any(.[]; .state=="open") then "open" elif any(.[]; .merged_at!=null) then "elsewhere:" + ([.[]|select(.merged_at!=null)|.base.ref]|first) else "none" end' 2>/dev/null) || st=ERR
        [ "$code" = 200 ] && [ "$st" != ERR ] || { unk="GitHub answered HTTP $code on the PRs of factory/$cid"; continue; }
        case "$st" in
          merged)   # merged into the base: unless a merged revert of exactly this PR exists (the search narrows, the title decides)
            q=$(jq -rn --arg q "repo:$drepo is:pr is:merged in:title \"Revert \\\"factory: $cid\\\"\"" '$q|@uri')
            resp=$(printf 'header = "Authorization: Bearer %s"\n' "$tok" | curl -sS -m 30 -K - -w '\n%{http_code}' -H "Accept: application/vnd.github+json" "https://api.github.com/search/issues?q=$q") || resp=$'\n000'
            code=${resp##*$'\n'}; body=${resp%$'\n'*}
            rv=$(printf '%s' "$body" | jq -r --arg t "Revert \"factory: $cid\"" 'if has("items") then ([.items[]|select(.title==$t)]|length) else "ERR" end' 2>/dev/null) || rv=ERR
            [ "$code" = 200 ] && [ "$rv" != ERR ] || { unk="GitHub answered HTTP $code on the revert search for factory/$cid"; continue; }
            if [ "$rv" -eq 0 ]; then echo merged; return; else anyrev=1; fi ;;
          open) anyopen=1 ;;
          elsewhere:*) elsewhere=${st#elsewhere:} ;;
        esac ;;
      *) sha=$(jq -r '.final_sha // empty' "$RUNS/$(basename "$g" .json)/manifest.json" 2>/dev/null || true)
         [ -n "$sha" ] || { unk="no run record for $cid under $RUNS"; continue; }
         dg=$(mktemp -d "${TMPDIR:-/tmp}/factory-dep.XXXXXX"); git init -q --bare "$dg"
         if ! git -C "$dg" fetch -q "$durl" "refs/heads/$bb:refs/heads/base" 2>/dev/null; then rm -rf "$dg"; unk="cannot fetch $bb from $durl"; continue; fi
         if git -C "$dg" merge-base --is-ancestor "$sha" refs/heads/base 2>/dev/null; then rm -rf "$dg"; echo merged; return; fi
         rm -rf "$dg"; anyopen=1 ;;   # judged and pushed, not on the base: what an open PR is on GitHub
    esac
  done
  [ -z "$anyq" ] || { echo queued; return; }
  # Held by deep lint, with nothing queued: dead (docs/cascade-plan.md, is_dead), ahead of an open PR or an unanswered lookup of an earlier attempt.
  for g in "$d"/held/*.reason; do [ -e "$g" ] || break; [ "$(base_id "$(basename "$g" .reason)")" != "$bid" ] || { echo "dead held: $(head -1 "$g" | cut -c1-200)"; return; }; done
  [ -z "$anyopen" ] || { echo open; return; }
  [ -z "$unk" ] || { echo "unknown $unk"; return; }
  [ -z "$anyrev" ] || { echo "reverted its merge was reverted"; return; }
  [ -z "$elsewhere" ] || { echo "dead merged into $elsewhere, not $bb"; return; }
  echo "dead nothing queued, no PR open or merged"
}
dep_token() {  # dep_token <owner/name or path> <repo_url>: the read-only token for the dependency check, cached in the lock dir for this batch
  # (a token lives 1h; refreshed after 50 min). GitHub: pull_requests:read, contents:read, minted with rundir unset so no run's manifest gets
  # that installation id. A dry run uses the file token.
  case "$2" in https://github.com/*) ;; *) cat "$FACTORY_SECRETS_DIR/github_token"; return ;; esac
  f="$LOCK/dep_tok"
  if [ -s "$f" ] && [ "$(head -1 "$f")" = "$1" ] && [ -z "$(find "$f" -mmin +50 2>/dev/null)" ]; then tail -1 "$f"; return; fi
  key=$(keycard_token "$GITHUB_APP_KEY_RESOURCE" | openssl base64 -d -A 2>/dev/null) || return 1; [ -n "$key" ] || return 1
  t=$( rundir=; mint_github_token "$1" "$key" '{"pull_requests":"read","contents":"read"}' ) || return 1; key=; [ -n "$t" ] || return 1
  ( umask 077; printf '%s\n%s\n' "$1" "$t" > "$f" ); printf '%s' "$t"
}

# ---------------------------------------------------------------- batch
cmd_batch() {  # factory batch [queue-dir] [--max-tasks N] [--stop-at HH:MM] [--no-chain] [--continue]: the overnight loop.
  # Tasks run in task-id order under one lock: the queue is listed afresh before every run and the first id after the last one taken
  # runs next, so a file the loop itself writes (an infra retry) runs next. Chain mode (default): every task after a successful one
  # cuts its branch from factory/<previous task_id> (passed to run as FACTORY_CHAIN_BASE; the task file is never changed), while its
  # PR still targets the task's own base_branch, so a merged-and-deleted chain head cannot break a later PR.
  # Every failed run is class task or infra (CLASS_JQ). Task: the task goes to <queue-dir>/failed/ and, without --continue, the batch
  # stops; with --continue every later task whose declared base names a task that failed tonight is moved to failed/ unrun, and the
  # chain goes on from the last task that passed (never from a failed branch, never back to main, which lacks every unmerged
  # predecessor). Infra never stops the batch by itself: with nothing pushed the file stays in the queue under its own id (nothing is
  # on GitHub, so the id is reusable tomorrow); with a branch pushed the task is retried once tonight as <id>-i1 from the same chain
  # base (an exit-11 conflict retries from the branch it conflicted with), and a retry that fails the same way is a task failure. Two
  # infra failures in a row from different tasks stop the batch with the queue as it is (the circuit breaker). HALT between tasks
  # stops it either way. Exit 0, or exit 4 (judged, pushed, only the PR missing), moves a task to <queue-dir>/done/<run_id>.json
  # (run_id is <timestamp>-<task_id>, and lint makes task_id the filename), so a rerun never repeats it. The batch's exit status is
  # the last run of a task that did not pass tonight, 0 when every task ran passed or was recovered by its retry.
  dir= max= stop_at= deadline= chain=on cont=
  while [ $# -gt 0 ]; do case "$1" in
    --max-tasks) max="${2:-}"; shift 2 ;; --stop-at) stop_at="${2:-}"; shift 2 ;; --no-chain) chain=; shift ;; --continue) cont=1; shift ;;
    -*) usage ;; *) [ -z "$dir" ] || usage; dir="$1"; shift ;; esac; done
  dir="${dir:-$QUEUE}"; [ -d "$dir" ] || die "no such queue: $dir"
  [ -z "$max" ] || [[ "$max" =~ ^[0-9]+$ ]] || die "--max-tasks needs a number"
  case "${FACTORY_NOTIFY_URL:-}" in *[\"\\[:space:]]*) die "FACTORY_NOTIFY_URL must not contain quotes, backslashes or whitespace (it is written into a curl config)";; esac
  [ -z "$stop_at" ] || deadline=$(date -j -f %H:%M "$stop_at" +%s 2>/dev/null) || die "--stop-at needs HH:MM (local time, today)"   # today at HH:MM, as an epoch
  [ -e "$HALT" ] && die "dispatch blocked by $HALT ($(cat "$HALT")); remove it to resume"
  out=$(cmd_lint "$dir") || { printf '%s\n' "$out"; die "fix the queue before batching (see "Writing tasks" in README.md)"; }   # quiet: it prints after deep lint
  [ -z "$chain" ] || [ "$(jq -r .repo "$dir"/*.json 2>/dev/null | sort -u | wc -l)" -le 1 ] || die "a chained queue targets one repo; use --no-chain"
  batch_id="batch-$(date -u +%Y%m%dT%H%M%SZ)"; report="$RUNS/$batch_id.md"; mkdir -p "$RUNS"
  take_lock; echo "$batch_id" > "$LOCK/run_id"; echo $$ > "$LOCK/pid"
  trap 'rm -rf "$LOCK"' EXIT; trap 'exit 130' INT TERM
  # Where notifications go, host only (a token in the URL never reaches the log): a silent night must say whether it could have spoken.
  nhost=off; if [ -n "${FACTORY_NOTIFY_URL:-}" ]; then nhost=${FACTORY_NOTIFY_URL#*://}; nhost=${nhost%%[/?#]*}; nhost=${nhost##*@}; fi
  echo "notify: $nhost$([ "$nhost" != off ] || echo ' (FACTORY_NOTIFY_URL not set)')"
  # Deep lint (docs/cascade-plan.md, loop 1): under the lock, since it rewrites the queue (another batch may own it), and before the
  # deterministic lint, which then checks what it changed (lint ran above too, so no model reads a queue lint refuses). Its own process, borrowing the lock like a run, since its container step can
  # exit from anywhere. A failure changes nothing: the night runs on the deterministic lint, notified. Each hold is notified once, when it
  # is made. FACTORY_DEEP_LINT=0 skips it for the night (the escape hatch, as FACTORY_GATE=0 is the gate's).
  dlsay=off dlrows= base_red=
  if [ "${FACTORY_DEEP_LINT:-1}" != 0 ]; then
    dl=0; FACTORY_BATCH=$$ "$0" lint --deep "$dir" || dl=$?
    dlid=$(cat "$LOCK/run_id"); echo "$batch_id" > "$LOCK/run_id"; echo $$ > "$LOCK/pid"; [ "$dlid" != "$batch_id" ] || dlid=   # no run id: it died before it was a run
    dres=; [ -z "$dlid" ] || dres=$(jq -r '.deep_lint.result // empty' "$RUNS/$dlid/manifest.json" 2>/dev/null) || dres=
    if [ "$dl" -eq 15 ]; then red=$(jq -r '.health.red // "red"' "$RUNS/$dlid/manifest.json" 2>/dev/null || echo red); dlsay="base is red ($red); nothing ran"; notify "stopped: the base is red ($red) at run $dlid; fix it (or FACTORY_HEALTH=0), then run again"; base_red="$red (run $dlid)"
    elif [ "$dl" -ne 0 ] && [ "$dres" = applying ]; then dlsay="failed while applying (exit $dl, run $dlid); the queue may be partly changed"; notify "deep lint failed while applying its result (exit $dl, run $dlid): the queue may be partly changed (deep_lint in the manifest has the plan); the night runs on the deterministic lint"
    elif [ "$dl" -ne 0 ]; then dlsay="failed (exit $dl${dlid:+, run $dlid}); deterministic lint only"; notify "deep lint failed (exit $dl${dlid:+, run $dlid}); the night runs on the deterministic lint"
    elif [ -z "$dlid" ]; then dlsay="nothing to read"
    else dm="$RUNS/$dlid/manifest.json"; dlsay="run $dlid, $(jq -r '"\(.deep_lint.added|length) task(s) gained depends_on, \(.deep_lint.held|length) held\(.deep_lint.revised // [] | if length > 0 then ", \(length) revised" else "" end)"' "$dm" 2>/dev/null || echo 'its manifest is unreadable')"
      while IFS=$'\t' read -r hid hk hr; do hr=${hr//|//}; dlrows="$dlrows| - | held | - | - | - | - | - | $hid ($hk): $hr |"$'\n'; notify "$hid held by deep lint ($hk): $hr"
      done < <(jq -r '.deep_lint.held[] | [.task_id, .kind, .reason] | @tsv' "$dm" 2>/dev/null)
      while IFS=$'\t' read -r hid hk hr; do hr=${hr//|//}; dlrows="$dlrows| - | revised | - | - | - | - | - | $hid ($hk): $hr |"$'\n'; notify "$hid revised by deep lint ($hk): $hr; it runs as revised, and its PR shows the task as written"
      done < <(jq -r '.deep_lint.revised // [] | .[] | [.task_id, .kind, .reason] | @tsv' "$dm" 2>/dev/null)
    fi
  fi
  cmd_lint "$dir" || die "the queue fails lint after deep lint (a file changed by hand meanwhile?); fix it before batching"   # deep lint applies only a queue that passes
  # Merge mode: main must be contained in next (a hotfix on main that was not forward-merged would be lost at the promotion, and every merge
  # tonight would build on a next that lacks it). Checked per GitHub repo the queue targets; anything but "behind" or "identical" stops the batch.
  if [ -n "$MERGER_APP_ID" ]; then
    for r in $(jq -r "select(.base_branch==\"$NEXT_BRANCH\") | .repo" "$dir"/*.json 2>/dev/null | sort -u); do
      repo_norm "$r" || continue; case "$repo_url" in https://github.com/*) ;; *) continue ;; esac
      tok=$(dep_token "$repo" "$repo_url") || tok=; [ -n "$tok" ] || { notify "stopped: no read token for $repo to check $MAIN_BRANCH is in $NEXT_BRANCH"; die "merge mode: no read token for $repo"; }
      gh_api "$tok" GET "/repos/$repo/compare/$NEXT_BRANCH...$MAIN_BRANCH"; st=$(jq -r '.status // "ERR"' <<< "$body" 2>/dev/null) || st=ERR; tok=
      case "$st" in behind|identical) echo "merge mode: $MAIN_BRANCH is in $NEXT_BRANCH on $repo ($st)" ;;
        *) notify "stopped: $MAIN_BRANCH is not contained in $NEXT_BRANCH on $repo (compare $NEXT_BRANCH...$MAIN_BRANCH: $st, HTTP $code); forward-merge it, then run again"
           die "merge mode: $MAIN_BRANCH is not contained in $NEXT_BRANCH on $repo (compare: $st, HTTP $code)" ;;
      esac
    done
  fi
  # passed/failed: base ids (an -i<N> retry counts for its task); prev: the literal chain head; outcomes: "<base id>=<rc>" per run, for the
  # exit status; retried: "<retry id>=<rc>/<outcome>" of the attempt a retry stands for; plain: retries cut from the task's own base.
  # failed: ids and base ids (an -i<N> retry counts for its task); prev: the literal chain head; outcomes: "<base id>=<rc>" per run
  # in order, 0 for a pass, for the exit status; retried: "<retry id>=<rc>/<outcome>" of the attempt a retry stands for; plain: retries
  # cut from the task's own base; next_id: a retry the loop wrote, run before anything else.
  rows= prev= prevsha= why= cursor= next_id= took=" " failed=" " passed=" " waited=" " retried=" " plain=" " outcomes= n=0 prs=0 nfail=0 nblk=0 ninfra=0 nwait=0 ndead=0 streak=0 lastinfra= streakids=
  # Held tasks, tonight's and older, stand as exit 10 (nothing ran; a human must act) until `factory unhold`: first in the order, so any run
  # that fails tonight decides the status before them, and a night is never quietly green while a task waits on the operator.
  # A held id that is in the queue again (restored by hand, not by unhold) runs, so it is not counted.
  nheld=0; for r in "$dir"/held/*.reason; do [ -e "$r" ] || break; h=$(basename "$r" .reason); [ ! -e "$dir/$h.json" ] || continue; nheld=$((nheld+1)); outcomes="$outcomes$(base_id "$h")=10 "; done
  while :; do
    [ -z "$base_red" ] || { why="the base is red: $base_red"; outcomes="$outcomes base=15 "; break; }   # the night's status: never quietly green with nothing run
    [ -e "$HALT" ] && { why="halted by $HALT ($(cat "$HALT"))"; break; }
    [ -z "$max" ] || [ "$n" -lt "$max" ] || { why="--max-tasks $max reached"; break; }
    [ -z "$deadline" ] || [ "$(date +%s)" -lt "$deadline" ] || { why="--stop-at $stop_at passed"; break; }
    # The next task: the retry the last run left, else the smallest id after the cursor in a fresh listing. Ids, not filenames:
    # "<id>-i1.json" sorts before "<id>.json" ('-' < '.'). A retry is taken by name and leaves the cursor where it was, so an id that
    # sorts between "<id>" and "<id>-i1" (such as "<id>-foo") is neither skipped nor run before the retry.
    task= tid= byname=
    if [ -n "$next_id" ] && [ -e "$dir/$next_id.json" ]; then task="$dir/$next_id.json"; tid=$next_id; byname=1
    else for f in "$dir"/*.json; do [ -e "$f" ] || break; i=$(basename "$f" .json)
      case "$took" in *" $i "*) continue ;; esac   # taken tonight already: a retry or a revision run by name leaves the cursor behind it, and one left in the queue (nothing pushed) must not be found again
      if { [ -z "$cursor" ] || [[ "$i" > "$cursor" ]]; } && { [ -z "$tid" ] || [[ "$i" < "$tid" ]]; }; then task=$f; tid=$i; fi; done; fi
    next_id=; took="$took$tid "
    [ -n "$task" ] || { [ "$n" -gt 0 ] || [ "$nwait" -gt 0 ] || [ "$nheld" -gt 0 ] || why="queue is empty"; break; }   # nothing after the cursor: the queue ran out, or was empty to begin with
    name=$(basename "$task" .json); cb= cbs=
    # A file that appeared after lint ran at the start (hand-added mid-night) may be malformed: a row and failed/, never a dead batch.
    if ! jq -e "$JOB_SCHEMA" "$task" >/dev/null 2>&1; then
      echo "== $name: skipped, not a task file"; rows="$rows| - | skipped | - | - | - | - | - | not a task file |"$'\n'
      mkdir -p "$dir/failed"; mv "$task" "$dir/failed/$batch_id-$name.json"; cursor=$name; continue
    fi
    id=$(jq -r .task_id "$task"); base=$(jq -r .base_branch "$task")
    case "$retried" in *" $id="*) ;; *) [ -n "$byname" ] || cursor=$name ;; esac   # a retry or a revision, taken by name, does not move the cursor
    bid=$(base_id "$id"); isretry=; [[ ! "$id" =~ -i[0-9]+$ ]] || isretry=1   # the task this run stands for; whether it is already an infra retry
    [ -z "$chain" ] || [ -z "$prev" ] || { cb="factory/$prev"; cbs=$prevsha; }   # the branch, and the commit it was at: the run falls back to the commit if the branch is gone
    case "$plain" in *" $id "*) cb= cbs= ;; esac
    # --continue: a base that failed tonight (declared in the file, or the chain head) was pushed as evidence only; do not build on it.
    skip= skipw=; for d in "$base" "$cb"; do case "$d" in factory/*) case "$failed" in *" ${d#factory/} "*) skip=$d ;; esac; case "$waited" in *" ${d#factory/} "*) skipw=$d ;; esac ;; esac; done
    if [ -n "$skip" ]; then
      echo "== $name: skipped, its base $skip failed in this batch"; rows="$rows| - | skipped | - | - | - | $skip | - | base failed tonight |"$'\n'
      failed="$failed$id "; mkdir -p "$dir/failed"; mv "$task" "$dir/failed/$batch_id-$name.json"; continue
    fi
    if [ -n "$skipw" ]; then   # a declared base that is itself waiting tonight does not exist yet: wait with it, do not build on nothing
      nwait=$((nwait+1)); w="waiting on ${skipw#factory/} (waiting itself)"; waited="$waited$id $bid "
      echo "== $name: $w"; rows="$rows| - | waiting | - | - | - | $skipw | - | $w |"$'\n'; continue
    fi
    # depends_on: each dependency must be on the branch this task is cut from, which means passed tonight (chain mode: the linear chain
    # holds every passed task) or merged into the base branch as GitHub says. Otherwise the task waits: untouched, visited once per night,
    # released the night after its dependency lands. A wait on something dead (nothing queued, no PR open or merged) is said so, counted
    # as dead for the exit status, and notified, so a night where everything waits on one dead root is never a quiet exit 0.
    # Every dependency is asked (a live wait must not hide a dead one behind it); the worst answer is reported: dead or reverted first,
    # then unknown (GitHub could not be asked: a wait, notified, never a verdict), then the first live wait (open, queued).
    waiting= wdead= wunk=
    for d in $(jq -r --arg re "$ID_RE" '.depends_on // [] | .[] | select(test($re))' "$task"); do   # the id grammar: lint enforced it at the start, a mid-night file was not linted
      db=$(base_id "$d"); if [ -n "$chain" ]; then case " $passed " in *" $db "*) continue ;; esac; fi
      r=$(dep_state "$dir" "$db" "$(jq -r .repo "$task")" "$base"); st=${r%% *}; [ "$st" != merged ] || continue
      case "$st" in
        dead|reverted) [ -n "$wdead" ] || { waiting="$db ($st): ${r#* }"; wdead=1; } ;;
        unknown) [ -n "$wdead" ] || [ -n "$wunk" ] || { waiting="$db ($st): ${r#* }"; wunk=1; } ;;
        *) [ -n "$waiting" ] || waiting="$db ($st)" ;;
      esac
    done
    if [ -n "$waiting" ]; then
      nwait=$((nwait+1)); w="waiting on $waiting"; waited="$waited$id $bid "
      echo "== $name: $w"; rows="$rows| - | waiting | - | - | - | - | - | $w |"$'\n'
      [ -z "$wdead" ] || { ndead=$((ndead+1)); outcomes="$outcomes$bid=1 "; }
      [ -z "$wdead$wunk" ] || notify "$name $w"
      continue
    fi
    echo "== $name ($(now))${cb:+, base $cb}"
    t0=$(date +%s); rc=0; FACTORY_BATCH=$$ FACTORY_CHAIN_BASE="$cb" FACTORY_CHAIN_SHA="$cbs" "$0" run "$task" || rc=$?
    # The run left its id in the borrowed lock; take the lock back at once, so a later `factory stop <that run>` signals nothing
    # and a run that dies before it takes the lock (docker down) cannot be mistaken for the previous one.
    run_id=$(cat "$LOCK/run_id"); echo "$batch_id" > "$LOCK/run_id"; echo $$ > "$LOCK/pid"; m="$RUNS/$run_id/manifest.json"
    if [ "$run_id" != "$batch_id" ] && [ -f "$m" ]; then
      # A run killed before its cleanup (SIGKILL, power) has no exit_status; the loop saw it and writes it, with the class, so no row says "running".
      [ "$(jq -r .exit_status "$m")" != null ] || { rundir="$RUNS/$run_id"; manifest_set '. + {ended_at:(.ended_at // $e), exit_status:$rc} | '"$END_JQ" --arg e "$(now)" --argjson rc "$rc"; }
      cells=$(jq -r '[(.exit_status // "running" | tostring), (.judge.rounds // "-" | tostring), (.judge.verdict // "-"), (.pr_url // "-")] | join(" | ")' "$m")
      outcome=$(jq -r '.outcome // empty' "$m"); reason=$(jq -r '.reason // empty' "$m")
      cls=$(jq -r '.class // ('"$CLASS_JQ"') // empty' "$m"); pushed=$(jq -r '.pushed != false' "$m")   # the same rule when the run left no class; null pushed (unknown) counts as pushed
    else run_id="$batch_id-$name"; cells="$rc | - | - | -"; outcome= reason= cls=infra pushed=false; fi   # died before it was a run (bad task file, docker down)
    [ "$rc" -eq 0 ] || [ -n "$cls" ] || cls=infra
    note=   # A retry that fails the way its original did has proved the failure reproducible: that is the task's, not the night's. Persisted.
    case "$retried" in *" $id=$rc/$outcome "*) cls=task; note="retry failed the same way"; rundir="$RUNS/$run_id"; manifest_set '. + {class:"task", class_note:"retry failed the same way as its original"}' ;; esac
    # The word on the phone: the verdict for a refusal, the outcome when there is one, else the number (an earlier round's verdict would
    # read as the reason for a worker that crashed later).
    bygate=; [ "$outcome" != refuted ] || [ "$(jq -r '.refuted_by // empty' "$m")" != gate ] || bygate=1
    case "$outcome" in refuted) what=REFUTED${bygate:+ by the gate} ;; "") what="exit $rc" ;; pr_failed) what="PR open failed, open it by hand" ;; *) what=$outcome ;; esac; new= rid=
    eff=$rc   # the run's standing for the exit status: 0 when it passed for the chain
    # pr_failed (4) is a pass for the chain: judged passing, pushed, every gate clean, only the PR missing (pr_error in the manifest). Decided
    # from the outcome, never from the number: a worker's own exit 4 passes through as the run's status and is nothing of the kind.
    if [ "$rc" -eq 0 ] || [ "$outcome" = pr_failed ]; then
      dest=done; prev=$id; passed="$passed$bid "; streak=0 lastinfra= streakids=; next=continuing; eff=0
      prevsha=$(jq -r 'select(.final_sha|type=="string") | .final_sha' "$m" 2>/dev/null) || prevsha=
      [ "$rc" -eq 0 ] || note="PR open failed; branch judged and pushed, open it by hand"
      # A scope note (docs/SCOPE-<id>.md: edits outside Scope the agent declared and the judge accepted) is in the PR body; the human reads it before merging.
      [ "$rc" -ne 0 ] || [ "$(jq -r '.scope_note // false' "$m" 2>/dev/null)" != true ] || { note="scope note in the PR: edits outside Scope, declared; read it before merging"; notify "$name opened its PR with a scope note (edits outside Scope, declared by the agent); read it before merging"; }
    elif [ "$cls" = infra ]; then
      ninfra=$((ninfra+1)); what="infra: $what"; failed="$failed$id "; [ "$id" = "$bid" ] || failed="$failed$bid "   # a declared base on this task is not built on, retry or not
      if [ "$lastinfra" != "$bid" ]; then streak=$((streak+1)); streakids="$streakids$id "; lastinfra=$bid; fi
      if [ "$pushed" != true ]; then dest=; note="nothing pushed; left in queue"; next="left in queue"
      elif [ "$outcome" = conflict ] && [ -n "$prev" ]; then dest=failed; note="conflicts with $base mid-chain; not retried (a retry from $base would drop the chain's work, one from the chain would conflict again)"; next=continuing
      elif [ -z "$isretry" ] && [ ! -e "$dir/$id-i1.json" ]; then new="$id-i1"; dest=failed; note="retrying as $new"; next="retrying as $new"
      elif [ -z "$isretry" ]; then dest=failed; note="$id-i1 is already queued; not retried again"; next=continuing
      else dest=failed; note="retry failed too; no second retry"; next=continuing; fi
    else
      dest=failed; failed="$failed$id "; [ "$id" = "$bid" ] || failed="$failed$bid "; streak=0 lastinfra= streakids=; next=$([ -n "$cont" ] && echo continuing || echo stopped)
      if [ "$outcome" = blocked ]; then nblk=$((nblk+1)); else nfail=$((nfail+1)); fi
    fi
    if [ -n "$dest" ]; then mkdir -p "$dir/$dest"; mv "$task" "$dir/$dest/$run_id.json"; task="$dir/$dest/$run_id.json"; fi
    # A blocked or refuted run that left an accepted revision (cmd_run, revise_attempt) runs again tonight as <base id>-r1, next, whether or not
    # --continue was given: the revised instructions with a paragraph saying where they came from, and the task as first written kept
    # in revised/ for the PR body. Written after the original is archived, like a retry. An id that exists anywhere is never reused,
    # and a revision that fails lint is not queued (the lint runs in a subshell: cmd_lint shares this loop's variable names).
    if { [ "$outcome" = blocked ] || [ "$outcome" = refuted ]; } && [ "$(jq -r '.revision.disposition // empty' "$m")" = proposed ] && jq -e "$REVISION_JQ" "$RUNS/$run_id/revision.json" >/dev/null 2>&1; then
      rid="$bid-r1"; for g in "$dir/$rid.json" "$dir"/done/*-"$rid".json "$dir"/failed/*-"$rid".json "$dir/held/$rid.json"; do [ ! -e "$g" ] || rid=; done
      rundir="$RUNS/$run_id"
      if [ -z "$rid" ]; then note="a revision was proposed, but $bid-r1 exists"; manifest_set '.revision = {disposition:"refused", reason:$r}' --arg r "$bid-r1 exists"
      else
        # The original and the reason first, then the queue file: a stop in between leaves revised/ files nothing reads, never a
        # revised task queued without the text its PR must show.
        mkdir -p "$dir/revised"; cp "$task" "$dir/revised/$rid.json"; jq -r '.reason + "\n\n" + .changes' "$RUNS/$run_id/revision.json" > "$dir/revised/$rid.reason"; lo=
        jq --arg id "$rid" --slurpfile r "$RUNS/$run_id/revision.json" --arg o "docs/BLOCKED-$id.md" --arg ob "docs/BLOCKED-$bid.md" --arg n "docs/BLOCKED-$rid.md" --arg a "Revised by the factory from $id (run $run_id), which ended $outcome: " \
          '.task_id=$id | .instructions = ($r[0].instructions | split("docs/BLOCKED-<task_id>.md") | join($n) | split($o) | join($n) | split($ob) | join($n)) + "\n\n" + $a + $r[0].reason + " The pull request shows the task as first written."' "$task" > "$dir/$rid.json" || lo="the queue file could not be written"
        if [ -z "$lo" ] && lo=$(cmd_lint "$dir" 2>&1); then next_id=$rid; note="revised as $rid"; next="revised as $rid"
        else rm -f "$dir/$rid.json" "$dir/revised/$rid.json" "$dir/revised/$rid.reason"; manifest_set '.revision = {disposition:"refused", reason:$r}' --arg r "the revised task fails lint: ${lo:0:300}"; echo "== $name: its revision fails lint and is not queued:"; printf '%s\n' "${lo:0:2000}"; note="the revision fails lint; not queued"; rid=; fi
      fi
    fi
    [ -z "$bygate" ] || note="refuted by the gate${note:+; $note}"   # the row's verdict cell is the judge's, which the gate overruled
    rows="$rows| $run_id | $cells | ${cb:--} | $(( $(date +%s) - t0 ))s | ${note:--} |"$'\n'; n=$((n+1)); outcomes="$outcomes$bid=$eff "
    [ "$rc" -eq 0 ] || notify "$name exited $rc ($what, $next)${reason:+: $reason}"
    [ "${cells##* | }" = - ] || prs=$((prs+1))   # the row's last cell is the PR URL or -
    # The retry file is written after the original is archived, so a kill between the two leaves nothing to run twice.
    # ponytail: retried and plain live in this loop only. A retry left queued by HALT, --max-tasks or --stop-at runs tomorrow as an ordinary
    # task: a same-way failure then reads as "retry failed too" (archived, no second retry), and a conflict retry is cut from the chain base.
    if [ -n "$new" ]; then jq --arg id "$new" --arg o "docs/BLOCKED-$id.md" --arg n "docs/BLOCKED-$new.md" '.task_id=$id | .instructions |= (split($o) | join($n))' "$task" > "$dir/$new.json"; retried="$retried$new=$rc/$outcome "; next_id=$new; [ "$outcome" != conflict ] || plain="$plain$new "; fi
    [ "$streak" -lt 2 ] || { why="two infra failures in a row (${streakids% })"; break; }
    [ "$eff" -eq 0 ] || [ "$cls" = infra ] || [ -n "$cont" ] || [ -n "$rid" ] || { why="$name exited $rc"; break; }   # 3 no changes, 5 REFUTED, 10 blocked, 14 manifest; the row has the verdict
  done
  left=$(ls "$dir"/*.json 2>/dev/null | wc -l | tr -d ' ' || true)   # || true: an empty queue makes ls fail, and a failed substitution in an assignment is fatal under set -e
  wsay=; [ "$nwait" -eq 0 ] || wsay=" ($nwait waiting on a dependency)"; [ "$nheld" -eq 0 ] || wsay="$wsay, $nheld held for a human (queue/held/)"
  if [ -n "$why" ]; then end="Stopped: $why. $left task(s) left in queue$wsay."
  elif [ "$n" -eq 0 ] && [ $((nwait+nheld)) -gt 0 ]; then end="Nothing ran. $left task(s) left in queue$wsay."
  elif [ "$left" -gt 0 ]; then end="All tasks ran. $left task(s) left in queue$wsay."
  else end="All tasks ran."; fi
  { echo "# $batch_id"; echo; echo "queue: $dir, chain: ${chain:-off}, notify: $nhost, tasks run: $n, deep lint: $dlsay"; echo
    echo "| RUN | EXIT | ROUNDS | VERDICT | PR | CHAIN BASE | DURATION | NOTE |"; echo "|---|---|---|---|---|---|---|---|"; printf '%s' "$dlrows$rows"
    echo; echo "$end"; } > "$report"
  cat "$report"; echo "report: $report"
  notify "done: $n run, $prs PR(s), $nfail failed$([ "$nblk" -eq 0 ] || echo ", $nblk blocked")$([ "$ninfra" -eq 0 ] || echo ", $ninfra infra")$([ "$nwait" -eq 0 ] || echo ", $nwait waiting")$([ "$ndead" -eq 0 ] || echo " ($ndead on a dead dependency)")$([ "$nheld" -eq 0 ] || echo ", $nheld held"). $end"   # always, once the loop is over: a night with no message means the batch never reached its end
  # Exit: each task's standing is its last run tonight (a retry that passed clears its original; a later failure under the same base id
  # counts). The status is the latest task whose last run did not pass, 0 when every task's last run passed.
  fail=0 seen=" "; set -- $outcomes; i=$#
  while [ "$i" -gt 0 ]; do e=${!i}; b=${e%=*}; case " $seen " in *" $b "*) ;; *) seen="$seen$b "; [ "${e##*=}" -eq 0 ] || [ "$fail" -ne 0 ] || fail=${e##*=} ;; esac; i=$((i-1)); done
  exit "$fail"
}

# ---------------------------------------------------------------- report
cmd_report() {  # factory report [n]: the last n runs (default 20), oldest first
  { printf 'RUN\tEXIT\tROUNDS\tVERDICT\tCOST\tPR\n'   # COST: the worker rounds' reported spend; "?" when a round has none, "-" with no rounds
    for m in "$RUNS"/*/manifest.json; do
      [ -e "$m" ] || break
      jq -r '[.run_id, (.exit_status // "running" | tostring), (.judge.rounds // "-" | tostring), (.judge.verdict // "-"),
              ((.worker.rounds // []) | if length==0 then "-" elif any(.[]; .reported_cost_usd==null) then "?" else (map(.reported_cost_usd) | add | tostring) end),
              (.pr_url // "-")] | @tsv' "$m"
    done | tail -n "${1:-20}"; } | column -t -s "$(printf '\t')"
}

# ---------------------------------------------------------------- requeue
cmd_requeue() {  # factory requeue <queue/failed/file.json>: the same task again as <id>-r<N> (a new id, since factory/<id> exists on the
  # repo), with what the last attempt learned appended to the instructions. Never called by batch: a task that fails the same way
  # twice is not run a third time on its own.
  f="${1:-}"; [ -f "$f" ] || usage; src="${2:-}"
  jq -e "$JOB_SCHEMA" "$f" >/dev/null 2>&1 || die "not a task file: $f"
  dir=$(cd "$(dirname "$f")/.." && pwd); id=$(jq -r .task_id "$f"); base_id=$(sed -E 's/-r[0-9]+$//' <<< "$id")
  # The source: the task as its generator writes it today. Its instructions (and depends_on, when it has one) replace the failed file's,
  # which carry the spec the attempt ran under; a spec fixed after a BLOCKED note is otherwise rerun unfixed (2026-11-03, 11-05).
  if [ -n "$src" ]; then
    [ -f "$src" ] && jq -e "$JOB_SCHEMA" "$src" >/dev/null 2>&1 || die "not a task file: $src"
    [ "$(jq -r .task_id "$src")" = "$(base_id "$id")" ] || die "source task_id $(jq -r .task_id "$src") is not $(base_id "$id")"
    [ "$(jq -r .repo "$src")" = "$(jq -r .repo "$f")" ] || die "source repo differs from the failed task's"
  fi
  # N = 1 + the highest -r<N> already used for this task in the queue, done/ and failed/, read from each file's task_id (a literal
  # match: an id may contain dots, and another id may end in -<this id>). 10#: a zero-padded N is not octal.
  last=0; for g in "$dir"/*.json "$dir"/done/*.json "$dir"/failed/*.json; do
    [ -e "$g" ] || continue; tid=$(jq -r '.task_id // empty' "$g" 2>/dev/null) || continue
    case "$tid" in "$base_id"-r*) k=${tid#"$base_id"-r}; case "$k" in ''|*[!0-9]*) ;; *) [ "$((10#$k))" -le "$last" ] || last=$((10#$k)) ;; esac ;; esac
  done
  new="$base_id-r$((last + 1))"; [ ! -e "$dir/$new.json" ] || die "$dir/$new.json already exists"
  # Evidence, only when this exact attempt has it: an executed run is archived as failed/<run_id>.json and has runs/<run_id>/;
  # a skipped task (failed/<batch_id>-<name>.json), a preflight failure (no manifest) or a round-1 worker failure (no judge file) has none.
  rid=$(basename "$f" .json); m="$RUNS/$rid/manifest.json"; add=
  if [ -f "$m" ]; then
    case "$(jq -r '.outcome // empty' "$m")" in
      blocked) add="Previous attempt ($id) was blocked: $(jq -r '.reason // empty' "$m")" ;;
      credential_in_input) add="Previous attempt ($id) was refused before it ran: something shaped like a credential in $(jq -r '.reason // empty' "$m"). It will be refused again until that is removed." ;;
      dependency_change) add="Previous attempt ($id) changed a dependency manifest ($(jq -r '.reason // empty' "$m")) without Scope naming package.json, so it got no PR. Either Scope names package.json or the manifest stays as it is." ;;
      *) rounds=$(jq -r '.judge.rounds // 0' "$m")
         [ "$rounds" -gt 0 ] && [ -f "$RUNS/$rid/judge-$rounds.md" ] \
           && add="Previous attempt ($id): judge $(jq -r '.judge.verdict // "no verdict"' "$m") after $rounds round(s). Findings:"$'\n'"$(head -c 20000 "$RUNS/$rid/judge-$rounds.md")" ;;
    esac
  fi
  [ -z "$add" ] || add=$'\n\n'"$add"
  # The note path in the task text follows the new id (README tells authors to write the literal id), so the gate finds the note under it.
  jq --arg id "$new" --arg add "$add" --arg o "docs/BLOCKED-$id.md" --arg n "docs/BLOCKED-$new.md" --slurpfile s "${src:-/dev/null}" \
     --arg ob "docs/BLOCKED-$(base_id "$id").md" \
     '(if $s|length>0 then .instructions=$s[0].instructions | (if $s[0].depends_on then .depends_on=$s[0].depends_on else del(.depends_on) end) else . end)
      | .task_id=$id | .instructions |= (split("docs/BLOCKED-<task_id>.md") | join($n)) | .instructions |= (split($ob) | join($n)) | .instructions |= (split($o) | join($n)) | .instructions+=$add' "$f" > "$dir/$new.json"
  echo "wrote $dir/$new.json${add:+ (with the findings of the previous attempt)}"
}

# ---------------------------------------------------------------- unhold
cmd_unhold() {  # factory unhold <queue/held/<id>.json | <id>.proposed.json>: after the operator's edit, the file given goes back into the queue
  # under its own id (deep lint holds before any run, so no branch claims the id), and the task's held files go; refused when the queue
  # would then fail lint (a later dependency in a proposal: reorder first). Deep lint reads it again at the next night. The touch is recorded in runs/touches.tsv (time, command, task id, sha256 of the file, user).
  f="${1:-}"; [ -f "$f" ] || usage
  jq -e "$JOB_SCHEMA" "$f" >/dev/null 2>&1 || die "not a task file: $f"
  h=$(cd "$(dirname "$f")" && pwd); [ "${h##*/}" = held ] || die "$f is not in a held/ directory"
  dir=${h%/held}; id=$(jq -r .task_id "$f"); b=$(basename "$f" .json); b=${b%.proposed}
  [ "$id" = "$b" ] || die "task_id $id is not the held file's id $b"
  [ ! -e "$dir/$id.json" ] || die "$dir/$id.json already exists"
  # Under the lock (no batch lists the queue while the file is in it unlinted), with INT and TERM ignored from the copy to the cleanup, so
  # a stop leaves the task held or released, never both, and the EXIT trap (which bash 3.2 skips on an unhandled TERM) frees the lock.
  take_lock; trap 'rm -rf "$LOCK"' EXIT; trap 'exit 130' INT TERM; echo unhold > "$LOCK/run_id"; echo $$ > "$LOCK/pid"
  trap '' INT TERM
  cp "$f" "$dir/.$id.json.$$" || die "cannot write into $dir"; mv "$dir/.$id.json.$$" "$dir/$id.json" || die "cannot write $dir/$id.json"   # a failed copy keeps the held files
  out=$(cmd_lint "$dir") || { rm -f "${dir:?}/${id:?}.json"; die "not unheld: with $id the queue fails lint (the batch would refuse the night):"$'\n'"$out"; }
  rm -f "${h:?}/${id:?}.json" "$h/$id.reason" "$h/$id.proposed.json"; trap 'exit 130' INT TERM
  mkdir -p "$RUNS"; printf '%s\tunhold\t%s\t%s\t%s\n' "$(now)" "$id" "$(shasum -a 256 "$dir/$id.json" | cut -d' ' -f1)" "${USER:-?}" >> "$RUNS/touches.tsv"
  echo "unheld $id: $dir/$id.json"
}

# ---------------------------------------------------------------- ruleset-check
cmd_ruleset_check() {  # factory ruleset-check <owner/name>: the negative tests of the target repo's rulesets with real tokens (docs/cascade-plan.md,
  # loop 7), run by hand once the next ruleset and the merger App exist: a push to next with the push token is refused; a merge without
  # factory-gate is refused; a merge with a stale sha is 409; with the check posted and the required checks green, the merge lands (an empty
  # commit on next, which proves the positive path); the rules on next name factory-gate; an App merge on main is refused (an App approval
  # is a note: whether it counts is what the merge shows). Creates one branch
  # factory/ruleset-check-<ts> (deletion is restricted by the ruleset, so it stays) and two PRs (closed at the end). Exit 1 on any FAIL.
  repo_norm "${1:-}" || usage; case "$repo_url" in https://github.com/*) ;; *) die "ruleset-check needs a GitHub repo" ;; esac
  [ -n "$MERGER_APP_ID" ] || die "MERGER_APP_ID is empty: no merger App to test with"
  [ -n "${FACTORY_SECRETS_DIR:-}" ] || die "FACTORY_SECRETS_DIR is not set"
  fails=0; say() { echo "$1: $2"; [ "$1" != FAIL ] || fails=$((fails+1)); }
  refused() { case "$code" in 403|405|409|422) return 0 ;; *) return 1 ;; esac; }   # a refusal by GitHub; a transport error or a 5xx proves nothing
  ts=$(date -u +%Y%m%dT%H%M%SZ); id="ruleset-check-$ts"; br="factory/$id"
  app_key=$(keycard_token "$GITHUB_APP_KEY_RESOURCE" | openssl base64 -d -A 2>/dev/null) || app_key=; [ -n "$app_key" ] || die "Keycard did not issue the GitHub App key"
  push_tok=$(mint_github_token "$repo" "$app_key" '{"contents":"write"}') || die "no push token"; app_key=
  mt=$(merger_token) || die "no merger token"
  w=$(mktemp -d "${TMPDIR:-/tmp}/factory-rc.XXXXXX"); trap 'rm -rf "$w"' EXIT
  clone_repo "$w" "$push_tok" || die "clone failed"
  ci() { git -C "$w" -c commit.gpgsign=false -c user.name="$GITHUB_APP_SLUG[bot]" -c user.email="$GITHUB_APP_SLUG[bot]@users.noreply.github.com" commit -q --allow-empty -m "factory: ruleset check $ts" || die "commit failed"; }
  # The push test: an empty commit on top of next, pushed by sha, so a refusal can only be the ruleset's (a non-fast-forward would be git's).
  git -C "$w" checkout -q --detach "origin/$NEXT_BRANCH" || die "no $NEXT_BRANCH on $repo"; ci; cn=$(git -C "$w" rev-parse HEAD)
  # The PRs: an empty commit on top of main, so the PR to main carries nothing else and a protection that fails cannot promote next.
  git -C "$w" checkout -q -b "$br" "origin/$MAIN_BRANCH" || die "no $MAIN_BRANCH on $repo"; ci
  sha=$(git -C "$w" rev-parse HEAD); base=$(git -C "$w" rev-parse "origin/$NEXT_BRANCH")
  if git -C "$w" -c credential.helper= -c credential.helper="$GIT_CRED" push -q "$repo_url" "$cn:refs/heads/$NEXT_BRANCH" 3< <(printf '%s' "$push_tok") 2>/dev/null
  then say FAIL "the push token pushed to $NEXT_BRANCH (an empty commit landed there; the ruleset must restrict updates to factory/**)"
  elif [ "$(git -C "$w" ls-remote -q "$repo_url" "refs/heads/$NEXT_BRANCH" 2>/dev/null | cut -f1)" = "$base" ]; then say PASS "the push token cannot push to $NEXT_BRANCH"
  else say FAIL "inconclusive: the push to $NEXT_BRANCH failed but $NEXT_BRANCH could not be read back or moved"; fi
  git -C "$w" -c credential.helper= -c credential.helper="$GIT_CRED" push -q "$repo_url" "HEAD:refs/heads/$br" 3< <(printf '%s' "$push_tok") || die "the push token cannot push $br either; nothing else can be tested"
  push_tok=
  gh_api "$mt" GET "/repos/$repo/rules/branches/$NEXT_BRANCH"
  if [ "$code" = 200 ] && [ "$(jq -r 'any(.[] | select(.type=="required_status_checks") | .parameters.required_status_checks[]?; .context=="factory-gate")' <<< "$body" 2>/dev/null)" = true ]; then say PASS "the rules on $NEXT_BRANCH require the factory-gate check"
  else say FAIL "the rules on $NEXT_BRANCH do not require factory-gate (HTTP $code ${body:0:200})"; fi
  pr=$(open_pr "$repo" "$id" "$NEXT_BRANCH" "Ruleset check $ts: an empty commit. Opened and merged by \`factory ruleset-check\`.") || die "cannot open the PR to $NEXT_BRANCH"
  n=${pr##*/}
  gh_api "$mt" PUT "/repos/$repo/pulls/$n/merge" "$(jq -nc --arg s "$sha" '{merge_method:"merge", sha:$s}')"
  if [ "$code" = 200 ]; then say FAIL "merged $pr without the factory-gate check (HTTP 200)"; elif refused; then say PASS "a merge without factory-gate is refused (HTTP $code)"; else say FAIL "inconclusive: a merge without factory-gate answered HTTP $code ${body:0:200}"; fi
  gh_api "$mt" POST "/repos/$repo/check-runs" "$(jq -nc --arg s "$sha" '{name:"factory-gate", head_sha:$s, status:"completed", conclusion:"success", output:{title:"factory gate passed", summary:"ruleset check"}}')"
  if [ "$code" = 201 ]; then say PASS "the merger App posted factory-gate on $sha"; else say FAIL "the merger App cannot post factory-gate (HTTP $code ${body:0:200})"; fi
  gh_api "$mt" PUT "/repos/$repo/pulls/$n/merge" "$(jq -nc --arg s "$base" '{merge_method:"merge", sha:$s}')"
  if [ "$code" = 409 ]; then say PASS "a merge with a stale sha is 409"; else say FAIL "a merge with a stale sha answered HTTP $code, not 409"; fi
  t0=$(date +%s); ms=unknown; while :; do gh_api "$mt" GET "/repos/$repo/pulls/$n"; ms=$(jq -r '.mergeable_state // "unknown"' <<< "$body" 2>/dev/null) || ms=unknown
    case "$ms" in clean|dirty) break ;; esac; [ $(( $(date +%s) - t0 )) -lt "$MERGE_WAIT_SEC" ] || break; sleep 30; done
  if [ "$ms" = clean ]; then
    gh_api "$mt" PUT "/repos/$repo/pulls/$n/merge" "$(jq -nc --arg s "$sha" '{merge_method:"merge", sha:$s}')"
    if [ "$code" = 200 ]; then say PASS "with factory-gate and the required checks green, the merger App merged $pr"; else say FAIL "the merge with everything green answered HTTP $code ${body:0:200}"; fi
  else say FAIL "PR $n never became mergeable (mergeable_state $ms after $(( $(date +%s) - t0 ))s): the required checks on $NEXT_BRANCH did not go green"; fi
  pr2=$(open_pr "$repo" "$id" "$MAIN_BRANCH" "Ruleset check $ts against $MAIN_BRANCH: must not be approvable or mergeable by an App. Closed by \`factory ruleset-check\`.") || { say FAIL "cannot open a PR to $MAIN_BRANCH"; pr2=; }
  if [ -n "$pr2" ]; then n2=${pr2##*/}
    gh_api "$mt" GET "/repos/$repo/pulls/$n2"; [ "$(jq -r '.base.ref' <<< "$body" 2>/dev/null)" = "$MAIN_BRANCH" ] || { say FAIL "PR $n2 is not against $MAIN_BRANCH (open_pr found an older PR from the same head); the $MAIN_BRANCH tests did not run"; pr2=; }
  fi
  if [ -n "$pr2" ]; then
    gh_api "$mt" POST "/repos/$repo/pulls/$n2/reviews" '{"event":"APPROVE","body":"ruleset check: an App approval must not count"}'
    if [ "$code" = 200 ]; then echo "note: the merger App could submit an approval on $pr2 (HTTP 200); whether it counts is what the merge below tests"; elif refused; then say PASS "an App approval on $MAIN_BRANCH is refused (HTTP $code)"; else echo "note: an App approval on $MAIN_BRANCH answered HTTP $code ${body:0:200}"; fi
    gh_api "$mt" PUT "/repos/$repo/pulls/$n2/merge" "$(jq -nc --arg s "$sha" '{merge_method:"merge", sha:$s}')"
    if [ "$code" = 200 ]; then say FAIL "the merger App merged $pr2 into $MAIN_BRANCH (an empty commit landed there)"; elif refused; then say PASS "an App merge on $MAIN_BRANCH is refused (HTTP $code)"; else say FAIL "inconclusive: an App merge on $MAIN_BRANCH answered HTTP $code ${body:0:200}"; fi
    gh_api "$mt" PATCH "/repos/$repo/pulls/$n2" '{"state":"closed"}'; [ "$code" = 200 ] || echo "note: could not close $pr2 (HTTP $code); close it by hand"
  fi
  mt=
  echo "branch $br stays on $repo (the ruleset restricts deletions); $fails FAIL"; [ "$fails" -eq 0 ]
}

# ---------------------------------------------------------------- stop
cmd_stop() {
  run_id="${1:-}"; [ -n "$run_id" ] || usage
  rundir="$RUNS/$run_id"; [ -d "$rundir" ] || die "no such run: $run_id"
  logf="$rundir/log.jsonl"
  echo "stopped $run_id at $(now). Remove this file to allow new runs." > "$HALT"   # first, so nothing new starts meanwhile
  echo "wrote $HALT (blocks new dispatch until removed)"
  if command -v docker >/dev/null; then
    # A run has one container at a time (worker, judge or push), all labelled with the run id.
    c=$(docker ps -q --filter "label=factory.run=$run_id" 2>/dev/null) || { c=; echo "docker is not answering; signalling the orchestrator anyway"; }
    if [ -n "$c" ]; then docker stop -t 5 $c >/dev/null 2>&1 && echo "stopped container(s) $c"; else echo "no container running for $run_id"; fi
    c=$(docker ps -aq --filter "label=factory.run=$run_id" 2>/dev/null) || c=; [ -n "$c" ] && docker rm -f $c >/dev/null 2>&1 || true
    docker network rm "factory-$run_id" >/dev/null 2>&1 || true   # a crashed orchestrator's network; harmless if the run already removed it
  else
    echo "docker not found; nothing to stop on this host"
  fi
  # An orchestrator still preparing this run (tokens, clone) has not started a container yet: interrupt it so it never does.
  opid=0; [ "$(cat "$LOCK/run_id" 2>/dev/null)" = "$run_id" ] && opid=$(cat "$LOCK/pid" 2>/dev/null || echo 0)
  # The outcome first, before the signal: a stopped task is the operator's decision (class task, failed/), never an infra failure the
  # batch would leave in the queue and dispatch again once HALT is removed.
  [ ! -f "$rundir/manifest.json" ] || manifest_set '.outcome //= "stopped"'
  alive=; if [ "$opid" -gt 0 ] 2>/dev/null && kill -0 "$opid" 2>/dev/null; then alive=1; kill -TERM "$opid" && echo "signalled orchestrator pid $opid"; fi
  log "factory stop by ${USER:-?}"   # append-only; safe beside the orchestrator's own writes
  # The manifest is written here only if no live orchestrator will finalize it (its cleanup records ended_at and exit_status).
  if [ -z "$alive" ] && [ -f "$rundir/manifest.json" ]; then
    manifest_set '.incidents = ((.incidents // []) + [{ts:$ts, action:"factory stop", by:env.USER}]) | .ended_at //= $ts | .exit_status //= 137 | '"$END_JQ" --arg ts "$(now)"
    echo "recorded incident in $rundir/manifest.json"
  fi
  cat <<EOF
TODO (not wired yet; do by hand):
  1. Revoke the Keycard grant for run $run_id in the factory zone.
  2. Revoke the GitHub App installation token for run $run_id (DELETE /installation/token with that token).
EOF
}

case "${1:-}" in
  run)    shift; cmd_run "$@" ;;
  lint)   shift; if [ "${1:-}" = --deep ]; then shift; cmd_deep_lint "$@"; else cmd_lint "$@"; fi ;;
  batch)  shift; cmd_batch "$@" ;;
  report) shift; cmd_report "$@" ;;
  requeue) shift; cmd_requeue "$@" ;;
  unhold) shift; cmd_unhold "$@" ;;
  stop)   shift; cmd_stop "$@" ;;
  ruleset-check) shift; cmd_ruleset_check "$@" ;;
  *)    usage ;;
esac
