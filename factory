#!/bin/bash
# factory: orchestrator for the software factory. See factory.md.
#   factory run <task-file>   validate job, mint run, docker run the sandbox, write manifest + log
#   factory lint [dir]        check queue/*.json against tasks.md before a batch
#   factory batch [dir] [--max-tasks N] [--stop-at HH:MM] [--no-chain] [--continue]
#                             the overnight queue: each task bases on the previous task's branch; stops on the first failure
#   factory report [n]        one line per run from the manifests: exit, judge rounds, verdict, PR
#   factory stop <run_id>     kill the container, block new dispatch, record the incident
# Compatible with the macOS /bin/bash (3.2). Needs: docker, git, jq.
set -euo pipefail
# Docker Desktop keeps its CLI inside the app bundle unless the /usr/local/bin symlinks were installed.
command -v docker >/dev/null || PATH="/Applications/Docker.app/Contents/Resources/bin:$PATH"

FACTORY_DIR="$(cd "$(dirname "$0")" && pwd)"
RUNS="$FACTORY_DIR/runs"
QUEUE="${FACTORY_QUEUE:-$FACTORY_DIR/queue}"   # task files; lint and batch read it by default (override for tests or a second queue)
LOCK="$FACTORY_DIR/.lock"   # one concurrent job; held by `factory run`, removed on exit
HALT="$FACTORY_DIR/HALT"    # written by `factory stop`; blocks dispatch until a human removes it
IMAGE="factory-sandbox"
TIMEOUT_SEC=3600
KEYCARD_ZONE="https://1jgewf106fax3oaf70vyykwj2i.keycard.cloud"   # software factory zone; brokers the Claude credential
ANTHROPIC_RESOURCE="https://api.anthropic.com"
# Anthropic Workload Identity Federation: Keycard's token is exchanged here for a 1h API token. None of these are secrets.
ANTHROPIC_ORG="91a560ee-bb99-440e-be20-49feb465f8cf"
ANTHROPIC_SERVICE_ACCOUNT="svac_01WjGbnYgXZB4GCXZgy9peKs"
ANTHROPIC_WORKSPACE="wrkspc_01MdoKfH7Q8tMGuuWx1Fgrnk"
ANTHROPIC_FEDERATION_RULE="fdrl_014KGxaZmUmk5veFbJ8uibXB"
GITHUB_APP_ID="Iv23liCLESgW74Wn2Ie2"     # GitHub App client id (accepted as JWT issuer); the private key lives in Keycard Vault
GITHUB_APP_KEY_RESOURCE="urn:factory:github-app-key"
OPENAI_RESOURCE="https://api.openai.com"       # Keycard Vault API Token credential on the OpenAI API resource: the Codex judge's key, fetched per judge round
MAX_ROUNDS=3                                   # worker -> judge rounds before the verdict is final

die()   { echo "factory: $*" >&2; exit 1; }
usage() { echo "usage: factory run <task-file> | factory lint [dir] | factory batch [queue-dir] [--max-tasks N] [--stop-at HH:MM] [--no-chain] [--continue] | factory report [n] | factory stop <run_id>" >&2; exit 2; }
# Job schema: exactly these four keys, all non-empty strings. Everything else is derived by the orchestrator.
JOB_SCHEMA='type=="object" and (keys|sort)==["base_branch","instructions","repo","task_id"] and all(.[]; type=="string" and length>0)'
ID_RE='^[A-Za-z0-9._-]+$'; BRANCH_RE='^[A-Za-z0-9._/-]+$'
now()   { date -u +%Y-%m-%dT%H:%M:%SZ; }

# ---------------------------------------------------------------- run
run_id= work= jwork= jout= logf= borrowed=
manifest_set() {  # manifest_set <jq-filter> [jq args...]: atomic update of this run's manifest
  f="$1"; shift
  jq "$@" "$f" "$rundir/manifest.json" > "$rundir/manifest.json.tmp.$$" && mv "$rundir/manifest.json.tmp.$$" "$rundir/manifest.json"
}
cleanup() {
  rc=$?
  # Best effort, every step: a docker outage here must not stop the manifest from being finalized or the lock from being released.
  if [ -n "$run_id" ]; then c=$(docker ps -aq --filter "label=factory.run=$run_id" 2>/dev/null) || c=; [ -n "$c" ] && docker rm -f $c >/dev/null 2>&1 || true; fi
  [ -n "$work" ] && rm -rf "$work"; [ -n "$jwork" ] && rm -rf "$jwork"; [ -n "$jout" ] && rm -rf "$jout"
  # A run that died before finalizing still gets a terminal state, so no manifest is left open-ended.
  if [ -n "${rundir:-}" ] && [ -f "$rundir/manifest.json" ] && [ "$(jq -r .ended_at "$rundir/manifest.json")" = null ]; then
    manifest_set '. + {ended_at:$ended, exit_status:$rc}' --arg ended "$(now)" --argjson rc "$rc"
  fi
  [ -n "$borrowed" ] || rm -rf "$LOCK"   # a borrowed lock belongs to the batch loop, which resets it when this run returns
}
take_lock() {  # one job at a time. mkdir is atomic. The lock names the holder's pid: a lock whose pid is gone is stale
  # (crash, SIGKILL) and is reclaimed; any factory container still around is then an orphan.
  if ! mkdir "$LOCK" 2>/dev/null; then
    lpid=$(cat "$LOCK/pid" 2>/dev/null || echo 0)
    if [ "$lpid" -gt 0 ] 2>/dev/null && kill -0 "$lpid" 2>/dev/null; then die "another run is in progress: $(cat "$LOCK/run_id" 2>/dev/null) (pid $lpid)"; fi
    echo "reclaiming stale lock left by run $(cat "$LOCK/run_id" 2>/dev/null)" >&2
    rm -rf "$LOCK"; mkdir "$LOCK" || die "cannot take lock $LOCK"
  fi
}
b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }
keycard_token() {  # keycard_token <resource>: client-credentials token for this Application; client secret via curl config on stdin, not argv
  printf 'user = "%s:%s"\n' "$(cat "$FACTORY_SECRETS_DIR/keycard_client_id")" "$(cat "$FACTORY_SECRETS_DIR/keycard_client_secret")" \
  | curl -sS -K - "$KEYCARD_ZONE/oauth/2/token" -d grant_type=client_credentials -d "resource=$1" \
  | jq -r '.access_token // empty'
}
mint_github_token() {  # mint_github_token <owner/name> <pem> <permissions-json>: 1h installation token scoped to that repo
  t=$(date +%s)
  hdr=$(printf '{"alg":"RS256","typ":"JWT"}' | b64url)
  pld=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' $((t-60)) $((t+540)) "$GITHUB_APP_ID" | b64url)
  sig=$(printf '%s.%s' "$hdr" "$pld" | openssl dgst -sha256 -sign <(printf '%s\n' "$2") -binary | b64url)   # key never touches disk
  jwt_cfg=$(printf 'header = "Authorization: Bearer %s.%s.%s"\nheader = "Accept: application/vnd.github+json"\n' "$hdr" "$pld" "$sig")
  # The App has one installation per account it is installed on, so the installation is looked up from the repo, not pinned.
  resp=$(printf '%s\n' "$jwt_cfg" | curl -sS -K - -w '\n%{http_code}' "https://api.github.com/repos/$1/installation")
  code=${resp##*$'\n'}; body=${resp%$'\n'*}
  case "$code" in
    200) inst=$(printf '%s' "$body" | jq -r '.id // empty') ;;
    404) echo "factory: GitHub App $GITHUB_APP_ID is not installed on $1 (GET /repos/$1/installation returned 404). Install it on ${1%%/*}, or add the repo to the existing installation: https://github.com/apps/kmaida-software-factory/installations/new" >&2; return 1 ;;
    *)   echo "factory: installation lookup for $1 failed (HTTP $code): $(printf '%s' "$body" | jq -r '.message // empty')" >&2; return 1 ;;
  esac
  [ -n "$inst" ] || return 1
  if [ -n "${rundir:-}" ]; then manifest_set '.installation_id = $id' --argjson id "$inst"; fi   # evidence: which installation issued this run's tokens
  printf '%s\n' "$jwt_cfg" \
  | curl -sS -K - -X POST "https://api.github.com/app/installations/$inst/access_tokens" \
      -d "{\"repositories\":[\"${1##*/}\"],\"permissions\":$3}" \
  | jq -r '.token // empty'
}
open_pr() {  # open_pr <owner/name> <task_id> <base> <instructions>: fresh pull_requests:write token, one API call, prints the PR URL
  key=$(keycard_token "$GITHUB_APP_KEY_RESOURCE" | openssl base64 -d -A 2>/dev/null) || return 1
  [ -n "$key" ] || return 1
  tok=$(mint_github_token "$1" "$key" '{"pull_requests":"write"}'); key=
  [ -n "$tok" ] || return 1
  resp=$(printf 'header = "Authorization: Bearer %s"\n' "$tok" \
  | curl -sS -K - -w '\n%{http_code}' -X POST "https://api.github.com/repos/$1/pulls" -H "Accept: application/vnd.github+json" \
      -d "$(jq -nc --arg t "factory: $2" --arg h "factory/$2" --arg b "$3" --arg body "$4" \
             '{title:$t, head:$h, base:$b, body:("Opened by the factory for task `"+$t+"`.\n\n"+$body)}')")
  code=${resp##*$'\n'}; body=${resp%$'\n'*}; body=${body//"$tok"/[REDACTED]}; body=${body:0:2000}; tok=
  if [ "$code" = 201 ]; then printf '%s' "$body" | jq -r '.html_url // empty'; return; fi
  # Exit 4 must be diagnosable from the run dir alone: status and (redacted, bounded) body go to the log and the manifest.
  log "POST /repos/$1/pulls failed: HTTP ${code:-none} $body"
  manifest_set '.pr_error = {status:(if $c=="" then null else ($c|tonumber) end), body:$b}' --arg c "$code" --arg b "$body"
  return 1
}
anthropic_token() {  # Claude credential, two steps, no API key anywhere. Fresh per worker round: the token lives 1h, a run may not.
  # 1. Keycard signs a 1h OIDC token for this Application (policy-checked, audited). Client secret via curl config on stdin, not argv.
  #    The token itself goes to jq on stdin for the same reason.
  kc=$(keycard_token "$ANTHROPIC_RESOURCE") || kc=
  [ -n "$kc" ] || { echo "factory: Keycard did not issue a token for $ANTHROPIC_RESOURCE (zone $KEYCARD_ZONE)" >&2; return 1; }
  # 2. Anthropic exchanges it for a 1h bearer token scoped to the factory workspace.
  printf '%s' "$kc" | jq -Rsc --arg r "$ANTHROPIC_FEDERATION_RULE" --arg o "$ANTHROPIC_ORG" --arg s "$ANTHROPIC_SERVICE_ACCOUNT" --arg w "$ANTHROPIC_WORKSPACE" \
      '{grant_type:"urn:ietf:params:oauth:grant-type:jwt-bearer", assertion:., federation_rule_id:$r, organization_id:$o, service_account_id:$s, workspace_id:$w}' \
    | curl -sS "$ANTHROPIC_RESOURCE/v1/oauth/token" -H "content-type: application/json" -d @- \
    | jq -r '.access_token // empty'
}
openai_key() {  # the judge's key: Keycard Vault for real runs, a file for dry runs (same split as the GitHub token)
  if [ "$gh_src" = file ]; then cat "$FACTORY_SECRETS_DIR/openai_key"; else keycard_token "$OPENAI_RESOURCE"; fi
}
log() {  # log <text>: one factory-side line in log.jsonl
  jq -nc --arg r "$run_id" --arg t "$1" '{run_id:$r, ts:(now|todate), event:{type:"factory", text:$t}}' >> "$logf"
}
run_container() {  # run_container <mode> <secret> [docker args...] -- [entrypoint args...]: one sandbox step; sets $status
  mode=$1; secret=$2; shift 2
  dargs=(); while [ $# -gt 0 ] && [ "$1" != -- ]; do dargs+=("$1"); shift; done; shift
  # Flags are fixed here; nothing in the task can change them. The secret goes over stdin; the entrypoint writes it to the tmpfs.
  # `factory stop` during preparation signals this process; the HALT check covers a stop that landed between that and now.
  [ -e "$HALT" ] && die "dispatch blocked by $HALT ($(cat "$HALT"))"
  b64=$(printf 'x-access-token:%s' "$secret" | openssl base64 -A)   # the Basic-auth form git prints in verbose traces
  cname="factory-$run_id-$mode-$round"
  log "container $cname starting"
  ( sleep "$TIMEOUT_SEC" && docker stop -t 10 "$cname" >/dev/null 2>&1 ) & watchdog=$!
  set +e
  printf '%s\n' "$secret" \
  | docker run -i --name "$cname" --label "factory.run=$run_id" --rm --read-only --tmpfs /tmp --tmpfs /run/secrets:size=64k \
    --memory 4g --cpus 2 --pids-limit 512 --cap-drop ALL --security-opt no-new-privileges \
    -e MODE="$mode" -e TASK_ID="$task_id" -e BASE_BRANCH="$base_branch" "${dargs[@]}" "$image_digest" "$@" 2>&1 \
  | while IFS= read -r line || [ -n "$line" ]; do
      line=${line//"$secret"/[REDACTED]}; line=${line//"$b64"/[REDACTED]}; printf '%s\n' "$line"
    done \
  | jq -R -c --arg r "$run_id" '{run_id:$r, ts:(now|todate), event:(. as $l | try fromjson catch {type:"text", text:$l})}' >> "$logf"
  status=${PIPESTATUS[1]}
  set -e
  kill "$watchdog" 2>/dev/null || true
  log "container $cname exited with status $status"
}

cmd_run() {
  task="${1:-}"; [ -n "$task" ] || usage
  [ -f "$task" ] || die "task file not found: $task"
  repo_url=
  command -v docker >/dev/null || die "docker not found; install Docker Desktop or OrbStack"
  docker info >/dev/null 2>&1 || die "docker daemon is not running"
  [ -e "$HALT" ] && die "dispatch blocked by $HALT ($(cat "$HALT")); remove it to resume"

  # Fail closed: the orchestrator's Keycard credential must exist before anything else happens.
  [ -n "${FACTORY_SECRETS_DIR:-}" ] || die "FACTORY_SECRETS_DIR is not set"
  for t in keycard_client_id keycard_client_secret; do
    [ -s "$FACTORY_SECRETS_DIR/$t" ] || die "missing or empty token file: $FACTORY_SECRETS_DIR/$t"
  done

  jq -e "$JOB_SCHEMA" "$task" >/dev/null 2>&1 || die "invalid task file: need exactly {repo, base_branch, task_id, instructions}, all non-empty strings"
  repo=$(jq -r .repo "$task"); base_branch=$(jq -r .base_branch "$task")
  task_id=$(jq -r .task_id "$task"); instructions=$(jq -r .instructions "$task")
  [[ "$task_id" =~ $ID_RE ]] || die "task_id must match $ID_RE"
  [[ "$base_branch" =~ $BRANCH_RE ]] || die "base_branch has unexpected characters"
  case "$repo" in
    https://github.com/*) repo="${repo#https://github.com/}"; repo="${repo%/}"; repo="${repo%.git}" ;;   # normalise to owner/name
    https://*|/*) repo_url="$repo" ;;                                   # other URL or local path (dry runs)
  esac
  case "$repo_url" in
    "") [[ "$repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "repo must be owner/name, a GitHub URL, another https URL, or a local path"
        repo_url="https://github.com/$repo.git" ;;
  esac
  # GitHub repos get a per-run installation token minted from the App key (fetched from Keycard Vault); anything else (dry runs) needs a github_token file.
  case "$repo_url" in
    https://github.com/*) ;;
    *) for t in github_token openai_key; do [ -s "$FACTORY_SECRETS_DIR/$t" ] || die "missing or empty token file: $FACTORY_SECRETS_DIR/$t"; done ;;
  esac
  for f in worker-prompt.md judge-prompt.md; do [ -s "$FACTORY_DIR/$f" ] || die "missing $FACTORY_DIR/$f"; done

  image_digest=$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null) || die "image $IMAGE not built; run: docker build -t $IMAGE ."
  # Which factory ran: this checkout's commit. The definition changes only by reviewed PR and `git pull`; a dirty tree is not that.
  factory_commit=$(git -C "$FACTORY_DIR" rev-parse HEAD 2>/dev/null) || factory_commit=
  if [ -n "$factory_commit" ] && [ -n "$(git -C "$FACTORY_DIR" status --porcelain)" ]; then
    [ "${FACTORY_ALLOW_DIRTY:-}" = 1 ] || die "factory checkout has uncommitted changes; land them by PR and git pull, or set FACTORY_ALLOW_DIRTY=1 for a development run"
    factory_commit="$factory_commit-dirty"
  fi

  # Inside `factory batch` the batch loop holds the lock for the whole queue and this run borrows it: it records its own id and
  # pid there (so `factory stop` signals the run, not the loop) and cleanup leaves it for the loop instead of removing it.
  if [ "${FACTORY_BATCH:-}" = "$PPID" ] && [ "$(cat "$LOCK/pid" 2>/dev/null)" = "$PPID" ]; then borrowed=1; else take_lock; fi
  trap cleanup EXIT; trap 'exit 130' INT TERM
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-$task_id"; echo "$run_id" > "$LOCK/run_id"; echo $$ > "$LOCK/pid"
  orphans=$(docker ps -aq --filter label=factory.run); if [ -n "$orphans" ]; then docker rm -f $orphans >/dev/null; fi

  rundir="$RUNS/$run_id"; mkdir -p "$rundir"; logf="$rundir/log.jsonl"; : > "$logf"
  echo "run $run_id"; echo "  evidence: $rundir"
  # Manifest exists from the first moment there is a run, before any credential is issued; later steps fill it in.
  jq -n --arg run_id "$run_id" --arg task_id "$task_id" --arg job "$(shasum -a 256 "$task" | cut -d' ' -f1)" \
        --arg repo "$repo" --arg base_branch "$base_branch" --arg cb "${FACTORY_CHAIN_BASE:-}" \
        --arg image "$image_digest" --arg fc "$factory_commit" --arg started "$(now)" --arg kz "$KEYCARD_ZONE" \
    '{run_id:$run_id, task_id:$task_id, job_sha256:$job, repo:$repo, base_branch:$base_branch, chain_base:(if $cb=="" then null else $cb end), base_sha:null,
      image_digest:$image, factory_commit:(if $fc=="" then null else $fc end), keycard_zone:$kz,
      installation_id:null, started_at:$started, ended_at:null, exit_status:null, final_sha:null, pr_url:null}' \
    > "$rundir/manifest.json"

  # GitHub token for the clone and the push: this repo only, contents:write only, expires in 60 min. It cannot open, approve or
  # merge pull requests; the host opens the PR afterwards with a separate token. The worker and the judge never hold it.
  case "$repo_url" in
    https://github.com/*) app_key=$(keycard_token "$GITHUB_APP_KEY_RESOURCE" | openssl base64 -d -A 2>/dev/null) || app_key=
                          [ -n "$app_key" ] || die "Keycard did not issue the GitHub App key (zone $KEYCARD_ZONE, resource $GITHUB_APP_KEY_RESOURCE)"
                          gh_tok=$(mint_github_token "$repo" "$app_key" '{"contents":"write"}') || gh_tok=; app_key=
                          [ -n "$gh_tok" ] || die "GitHub did not issue an installation token for $repo"
                          gh_src="GitHub App $GITHUB_APP_ID, repo $repo; key from Keycard $GITHUB_APP_KEY_RESOURCE" ;;
    *) gh_tok=$(cat "$FACTORY_SECRETS_DIR/github_token"); gh_src="file" ;;
  esac

  # Clone (the container never sees the task file; only /work and /run/secrets are mounted).
  work=$(mktemp -d "${TMPDIR:-/tmp}/factory-work.XXXXXX")
  # `credential.helper=` first clears inherited helpers (the mini's system gitconfig sets osxkeychain, which would store the
  # token on success). Ours answers only for github.com and reads the token from fd 3, so it is in neither argv nor the environment.
  git -c credential.helper= \
      -c credential.helper='!f() { h=; while IFS= read -r l; do case "$l" in host=*) h=${l#host=};; esac; done; [ "$h" = github.com ] || exit 0; echo username=x-access-token; echo "password=$(cat <&3)"; }; f' \
    clone -q "$repo_url" "$work" 3< <(printf '%s' "$gh_tok") || die "clone failed: $repo_url"
  base_sha=$(git -C "$work" rev-parse "origin/$base_branch" 2>/dev/null) || die "base branch not found: $base_branch"
  log "cloned $repo_url at $base_sha"
  manifest_set '. + {base_sha:$sha}' --arg sha "$base_sha"
  if git -C "$work" rev-parse --verify -q "origin/factory/$task_id" >/dev/null; then
    die "branch factory/$task_id already exists on $repo; delete it or use a new task_id (a rerun would diverge from it and fail to push)"
  fi

  gh_tok=   # the clone is done; the push mints its own token later, so none is held while the agents run

  # Worker -> judge rounds. Each step is its own container with exactly one secret: the worker has the Claude credential,
  # the judge has the Codex key, the push has the GitHub token. The judge reviews a fresh clone of the worker's checkout and
  # ends with a VERDICT line; anything but VERIFIED sends its findings back to the worker for a revision round, up to MAX_ROUNDS.
  # Nothing is pushed until the rounds are over, so no human sees the code before the judge has.
  round=1 verdict= findings= head= prev_head= status=0
  while :; do
    # Every worker round opens with the house rules (least code that satisfies "Done when"), read from this checkout like the judge prompt.
    prompt="$(cat "$FACTORY_DIR/worker-prompt.md")"$'\n\n'"## Task"$'\n'"$instructions"
    [ -n "$findings" ] && prompt="$prompt"$'\n\n'"## Review of your previous attempt (round $((round-1)) verdict: $verdict)"$'\n'"The reviewer refused the branch as it stands. Fix every finding below on the current branch, keep the task's scope, and commit. Findings:"$'\n'"$findings"
    an_tok=$(anthropic_token) || an_tok=; [ -n "$an_tok" ] || die "Anthropic did not exchange the Keycard token (rule $ANTHROPIC_FEDERATION_RULE, workspace $ANTHROPIC_WORKSPACE)"
    log "round $round: anthropic_token issued (Keycard $KEYCARD_ZONE -> Anthropic WIF rule $ANTHROPIC_FEDERATION_RULE, workspace $ANTHROPIC_WORKSPACE); ttl ${TIMEOUT_SEC}s"
    run_container work "$an_tok" -v "$work":/work -- "$prompt"; an_tok=
    [ "$status" -eq 0 ] || break
    head=$(git -C "$work" rev-parse --verify -q "refs/heads/factory/$task_id") || die "worker exited 0 but factory/$task_id does not exist"
    if [ "$head" = "$prev_head" ]; then log "round $round: no new commits; the round $((round-1)) verdict stands"; round=$((round-1)); break; fi   # rounds = judged rounds
    prev_head=$head

    oa_key=$(openai_key) || oa_key=; [ -n "$oa_key" ] || die "no Codex key (Keycard $OPENAI_RESOURCE)"
    log "round $round: openai_key issued (Keycard $KEYCARD_ZONE resource $OPENAI_RESOURCE)"
    jwork=$(mktemp -d "${TMPDIR:-/tmp}/factory-judge.XXXXXX"); jout=$(mktemp -d "${TMPDIR:-/tmp}/factory-judge-out.XXXXXX")
    jprompt="$(cat "$FACTORY_DIR/judge-prompt.md")"$'\n\n'"## Commits"$'\n'"Base: $base_sha"$'\n'"Head: $head"$'\n\n'"## Task given to the agent"$'\n'"$instructions"
    run_container judge "$oa_key" -v "$work":/src:ro -v "$jwork":/work -v "$jout":/out -e HEAD_SHA="$head" -- "$jprompt"
    jstatus=$status; status=0   # the worker succeeded; a failed judge is a missing verdict (exit 6 below), not a failed run
    # The verdict counts only if the judge exited 0 and left a regular file in /out, a mount the repository cannot reach.
    # Bounded read; then redact the judge's key before the text goes anywhere (the next prompt, the PR body, evidence).
    findings=
    if [ "$jstatus" -eq 0 ] && [ -f "$jout/verdict.md" ] && [ ! -L "$jout/verdict.md" ]; then findings=$(head -c 200000 "$jout/verdict.md"); fi
    findings=${findings//"$oa_key"/[REDACTED]}; oa_key=
    rm -rf "$jwork" "$jout"; jwork= jout=
    printf '%s\n' "$findings" > "$rundir/judge-$round.md"   # evidence: the full review, one file per round
    # The last non-blank line must be the verdict line, whole; anything else is no verdict.
    verdict=$(printf '%s\n' "$findings" | sed -e '/^[[:space:]]*$/d' | tail -1 | grep -E '^VERDICT: (VERIFIED|CAVEATS|REFUTED)[[:space:]]*$' | awk '{print $2}' || true)
    log "round $round: judge verdict ${verdict:-NONE} (container status $jstatus, $(printf '%s' "$findings" | wc -c | tr -d ' ') bytes)"
    echo "  round $round: judge verdict ${verdict:-NONE}"
    [ -n "$verdict" ] || break                 # judge error: nothing to revise against; fail closed below
    [ "$verdict" = VERIFIED ] && break
    [ "$round" -ge "$MAX_ROUNDS" ] && break
    round=$((round+1))
  done
  wstatus=$status

  # Push the last judged commit whenever there is one (evidence, and the human's starting point if they want it), even when a
  # later revision round failed, with a fresh token the agents never held. A round-1 worker that fails leaves nothing to push. Then the PR: only when every worker round succeeded and
  # the verdict is VERIFIED or CAVEATS. REFUTED exits 5 and NONE exits 6, both without a PR.
  final_sha=${head:-null}; pr_url=
  if [ "$final_sha" != null ]; then
    case "$gh_src" in
      file) gh_tok=$(cat "$FACTORY_SECRETS_DIR/github_token") ;;
      *) app_key=$(keycard_token "$GITHUB_APP_KEY_RESOURCE" | openssl base64 -d -A 2>/dev/null) || app_key=
         gh_tok=$(mint_github_token "$repo" "$app_key" '{"contents":"write"}') || gh_tok=; app_key= ;;
    esac
    [ -n "$gh_tok" ] || die "GitHub did not issue a push token for $repo"
    run_container push "$gh_tok" -v "$work":/src:ro -e REPO_URL="$repo_url" -e HEAD_SHA="$head" --; gh_tok=   # read-only mount; pushes the judged commit by SHA
    if [ "$status" -ne 0 ]; then log "push of factory/$task_id failed"; [ "$wstatus" -eq 0 ] || status=$wstatus
    elif [ "$wstatus" -ne 0 ]; then log "worker failed in round $round (status $wstatus); branch pushed, no PR"; status=$wstatus
    else
      case "$verdict" in
        VERIFIED|CAVEATS)
          if [ "$gh_src" != file ]; then
            # The PR is opened here, not by an agent: a separate token with pull_requests:write that no container ever held.
            body="$instructions"$'\n\n'"## Judge (Codex), $round round(s), verdict $verdict"$'\n\n'"$findings"
            pr_url=$(open_pr "$repo" "$task_id" "$base_branch" "$body") || pr_url=
            if [ -n "$pr_url" ]; then log "opened $pr_url"; else log "branch factory/$task_id pushed but opening the PR failed; open it by hand"; status=4; fi
          fi ;;
        REFUTED) log "refuted after $round round(s); branch pushed, no PR"; status=5 ;;
        *)       log "judge gave no verdict; branch pushed, no PR"; status=6 ;;
      esac
    fi
  fi
  manifest_set '. + {ended_at:$ended, exit_status:$status, final_sha:(if $final=="null" then null else $final end), pr_url:(if $pr=="" then null else $pr end),
                     judge:{rounds:$rounds, verdict:(if $v=="" then null else $v end)}}' \
     --arg ended "$(now)" --argjson status "$status" --arg final "$final_sha" --arg pr "$pr_url" --argjson rounds "$round" --arg v "$verdict"
  echo "  exit status: $status"
  exit "$status"
}

# ---------------------------------------------------------------- lint
cmd_lint() {  # factory lint [dir]: the conventions in tasks.md that a sleeping operator cannot enforce. Exit 1 on any problem.
  dir="${1:-$QUEUE}"; bad=0; n=0; seen=" "
  for f in "$dir"/*.json; do
    [ -e "$f" ] || { echo "no task files in $dir"; return 0; }
    name=$(basename "$f" .json); p=
    if ! jq -e "$JOB_SCHEMA" "$f" >/dev/null 2>&1; then p="$p; not {repo, base_branch, task_id, instructions}, all non-empty strings"
    else
      id=$(jq -r .task_id "$f"); base=$(jq -r .base_branch "$f")
      [ "$id" = "$name" ] || p="$p; task_id '$id' is not the filename"
      [[ "$id" =~ $ID_RE && "$id" =~ ^[0-9]+- ]] || p="$p; task_id must be <number>-<name> matching $ID_RE"
      [[ "$base" =~ $BRANCH_RE ]] || p="$p; base_branch has unexpected characters"
      # The five headings of tasks.md, each at the start of a line, in order, and something after "Done when:".
      jq -e '.instructions | test("(^|\n)Goal:[\\s\\S]*\nContext:[\\s\\S]*\nScope:[\\s\\S]*\nDone when:[ \t]*\\S[\\s\\S]*\nOut of scope:")' "$f" >/dev/null \
        || p="$p; instructions need the headings Goal, Context, Scope, Done when, Out of scope, in that order, each on its own line"
      case "$base" in
        factory/*) dep=${base#factory/}
                   case " $seen " in *" $dep "*) ;;   # an earlier task in this queue
                     *) if [ -e "$dir/$dep.json" ]; then p="$p; base_branch $base is a later task in the queue"; else echo "$name: base_branch $base is not in the queue; it must already exist on the repo"; fi ;;
                   esac ;;
      esac
      seen="$seen$id "
    fi
    n=$((n+1))
    [ -z "$p" ] || { echo "$name:${p#;}"; bad=1; }
  done
  [ "$bad" -eq 0 ] && echo "lint ok: $n task(s)"
  return "$bad"
}

# ---------------------------------------------------------------- batch
cmd_batch() {  # factory batch [queue-dir] [--max-tasks N] [--stop-at HH:MM] [--no-chain] [--continue]: the overnight loop.
  # Tasks run in filename order under one lock. Chain mode (default): every task after a successful one bases on
  # factory/<previous task_id>, so the night ends as a stack of judged PRs to merge bottom-up; the rewritten base_branch lives in a
  # temp copy of the task file under $TMPDIR, the file on disk is never changed. Any exit but 0 stops the batch: that task goes to
  # <queue-dir>/failed/, every later one stays in the queue untouched. With --continue the batch goes on instead: a failed run still
  # pushes its branch (evidence), so every later task whose base names a task that failed tonight is moved to failed/ unrun, and the
  # chain resumes from the next task's own base_branch. HALT between tasks stops the batch either way. Exit 0 moves a task to
  # <queue-dir>/done/<run_id>.json (run_id is <timestamp>-<task_id>, and lint makes task_id the filename), so a rerun never repeats it.
  dir= max= stop_at= deadline= chain=on cont=
  while [ $# -gt 0 ]; do case "$1" in
    --max-tasks) max="${2:-}"; shift 2 ;; --stop-at) stop_at="${2:-}"; shift 2 ;; --no-chain) chain=; shift ;; --continue) cont=1; shift ;;
    -*) usage ;; *) [ -z "$dir" ] || usage; dir="$1"; shift ;; esac; done
  dir="${dir:-$QUEUE}"; [ -d "$dir" ] || die "no such queue: $dir"
  [ -z "$max" ] || [[ "$max" =~ ^[0-9]+$ ]] || die "--max-tasks needs a number"
  [ -z "$stop_at" ] || deadline=$(date -j -f %H:%M "$stop_at" +%s 2>/dev/null) || die "--stop-at needs HH:MM (local time, today)"   # today at HH:MM, as an epoch
  [ -e "$HALT" ] && die "dispatch blocked by $HALT ($(cat "$HALT")); remove it to resume"
  cmd_lint "$dir" || die "fix the queue before batching (see tasks.md)"
  [ -z "$chain" ] || [ "$(jq -r .repo "$dir"/*.json 2>/dev/null | sort -u | wc -l)" -le 1 ] || die "a chained queue targets one repo; use --no-chain"
  batch_id="batch-$(date -u +%Y%m%dT%H%M%SZ)"; report="$RUNS/$batch_id.md"
  take_lock; echo "$batch_id" > "$LOCK/run_id"; echo $$ > "$LOCK/pid"
  tmpjob=; trap 'rm -rf "$LOCK" ${tmpjob:+"$tmpjob"}' EXIT; trap 'exit 130' INT TERM
  rows= prev= why= failed=" " n=0 fail=0
  for task in "$dir"/*.json; do
    [ -e "$task" ] || { why="queue is empty"; break; }
    [ -e "$HALT" ] && { why="halted by $HALT ($(cat "$HALT"))"; break; }
    [ -z "$max" ] || [ "$n" -lt "$max" ] || { why="--max-tasks $max reached"; break; }
    [ -z "$deadline" ] || [ "$(date +%s)" -lt "$deadline" ] || { why="--stop-at $stop_at passed"; break; }
    name=$(basename "$task" .json); id=$(jq -r .task_id "$task"); base=$(jq -r .base_branch "$task"); cb=; job="$task"
    [ -z "$chain" ] || [ -z "$prev" ] || { cb="factory/$prev"; base="$cb"; }
    case "$failed" in *" ${base#factory/} "*)   # --continue: its base failed tonight (branch pushed as evidence); do not build on it
      echo "== $name: skipped, its base $base failed in this batch"; rows="$rows| - | skipped | - | - | - | $base | - |"$'\n'
      failed="$failed$id "; mkdir -p "$dir/failed"; mv "$task" "$dir/failed/$batch_id-$name.json"; continue ;;
    esac
    if [ -n "$cb" ]; then tmpjob=$(mktemp "${TMPDIR:-/tmp}/factory-task.XXXXXX"); job="$tmpjob"; jq --arg b "$cb" '.base_branch=$b' "$task" > "$job"; fi
    echo "== $name ($(now))${cb:+, base $cb}"
    t0=$(date +%s); rc=0; FACTORY_BATCH=$$ FACTORY_CHAIN_BASE="$cb" "$0" run "$job" || rc=$?
    [ -z "$tmpjob" ] || rm -f "$tmpjob"; tmpjob=
    # The run left its id in the borrowed lock; take the lock back at once, so a later `factory stop <that run>` signals nothing
    # and a run that dies before it takes the lock (docker down) cannot be mistaken for the previous one.
    run_id=$(cat "$LOCK/run_id"); echo "$batch_id" > "$LOCK/run_id"; echo $$ > "$LOCK/pid"; m="$RUNS/$run_id/manifest.json"
    if [ "$run_id" != "$batch_id" ] && [ -f "$m" ]; then
      cells=$(jq -r '[(.exit_status // "running" | tostring), (.judge.rounds // "-" | tostring), (.judge.verdict // "-"), (.pr_url // "-")] | join(" | ")' "$m")
    else run_id="$batch_id-$name"; cells="$rc | - | - | -"; fi   # died before it was a run (bad task file, docker down)
    rows="$rows| $run_id | $cells | ${cb:--} | $(( $(date +%s) - t0 ))s |"$'\n'; n=$((n+1))
    if [ "$rc" -eq 0 ]; then dest=done; prev=$id; else dest=failed; prev=; failed="$failed$id "; fail=$rc; fi
    mkdir -p "$dir/$dest"; mv "$task" "$dir/$dest/$run_id.json"
    [ "$rc" -eq 0 ] || [ -n "$cont" ] || { why="$name exited $rc"; break; }   # 3 no changes, 4 PR failed, 5 REFUTED, 6 no verdict; the row has the verdict
  done
  { echo "# $batch_id"; echo; echo "queue: $dir, chain: ${chain:-off}, tasks run: $n"; echo
    echo "| RUN | EXIT | ROUNDS | VERDICT | PR | CHAIN BASE | DURATION |"; echo "|---|---|---|---|---|---|---|"; printf '%s' "$rows"
    echo; if [ -n "$why" ]; then echo "Stopped: $why. $(ls "$dir"/*.json 2>/dev/null | wc -l | tr -d ' ') task(s) left in queue."; else echo "All tasks ran."; fi; } > "$report"
  cat "$report"; echo "report: $report"
  exit "$fail"   # the last failing run's status, 0 when every run passed
}

# ---------------------------------------------------------------- report
cmd_report() {  # factory report [n]: the last n runs (default 20), oldest first
  { printf 'RUN\tEXIT\tROUNDS\tVERDICT\tPR\n'
    for m in "$RUNS"/*/manifest.json; do
      [ -e "$m" ] || break
      jq -r '[.run_id, (.exit_status // "running" | tostring), (.judge.rounds // "-" | tostring), (.judge.verdict // "-"), (.pr_url // "-")] | @tsv' "$m"
    done | tail -n "${1:-20}"; } | column -t -s "$(printf '\t')"
}

# ---------------------------------------------------------------- stop
cmd_stop() {
  run_id="${1:-}"; [ -n "$run_id" ] || usage
  rundir="$RUNS/$run_id"; [ -d "$rundir" ] || die "no such run: $run_id"
  logf="$rundir/log.jsonl"
  echo "stopped $run_id at $(now). Remove this file to allow new runs." > "$HALT"   # first, so nothing new starts meanwhile
  echo "wrote $HALT (blocks new dispatch until removed)"
  if command -v docker >/dev/null; then
    # A run has one container at a time (worker, judge or push), all labelled with the run id.
    c=$(docker ps -q --filter "label=factory.run=$run_id")
    if [ -n "$c" ]; then docker stop -t 5 $c >/dev/null 2>&1 && echo "stopped container(s) $c"; else echo "no container running for $run_id"; fi
    c=$(docker ps -aq --filter "label=factory.run=$run_id"); [ -n "$c" ] && docker rm -f $c >/dev/null 2>&1 || true
  else
    echo "docker not found; nothing to stop on this host"
  fi
  # An orchestrator still preparing this run (tokens, clone) has not started a container yet: interrupt it so it never does.
  opid=0; [ "$(cat "$LOCK/run_id" 2>/dev/null)" = "$run_id" ] && opid=$(cat "$LOCK/pid" 2>/dev/null || echo 0)
  alive=; if [ "$opid" -gt 0 ] 2>/dev/null && kill -0 "$opid" 2>/dev/null; then alive=1; kill -TERM "$opid" && echo "signalled orchestrator pid $opid"; fi
  log "factory stop by ${USER:-?}"   # append-only; safe beside the orchestrator's own writes
  # The manifest is written here only if no live orchestrator will finalize it (its cleanup records ended_at and exit_status).
  if [ -z "$alive" ] && [ -f "$rundir/manifest.json" ]; then
    manifest_set '.incidents = ((.incidents // []) + [{ts:$ts, action:"factory stop", by:env.USER}]) | .ended_at //= $ts | .exit_status //= 137' --arg ts "$(now)"
    echo "recorded incident in $rundir/manifest.json"
  fi
  cat <<EOF
TODO (not wired yet; do by hand):
  1. Revoke the Keycard grant for run $run_id in the factory zone.
  2. Revoke the GitHub App installation token for run $run_id (DELETE /installation/token with that token).
EOF
}

case "${1:-}" in
  run)    shift; cmd_run "$@" ;;
  lint)   shift; cmd_lint "$@" ;;
  batch)  shift; cmd_batch "$@" ;;
  report) shift; cmd_report "$@" ;;
  stop)   shift; cmd_stop "$@" ;;
  *)    usage ;;
esac
