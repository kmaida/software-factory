# The deep-lint answer's contract: every queued task exactly once, depends_on a list of task ids, hold null or {kind, reason, proposed_instructions}.
DEEP_JQ='(.tasks|type=="array") and (.tasks|length)==($ids|length) and ([.tasks[]|objects|.task_id]|sort)==($ids|sort)
  and all(.tasks[]; (.depends_on|type=="array" and all(.[]; type=="string" and test($re))) and (.hold==null or (.hold|type=="object"
  and (.kind|IN("missing_prerequisite","contradiction","ambiguity","human_input")) and (.reason|type=="string" and length>0) and ((.proposed_instructions // "")|type=="string"))))'
cmd_deep_lint() {  # factory lint --deep [dir] (docs/cascade-plan.md, loop 1): before a night, one fresh Codex session (the judge arm, with
  # deep-lint-prompt.md) reads the queue and a clone of its base branch, both read-only, and says per task what it relies on and who supplies
  # it. The host applies only what can delay a task, never what widens one: depends_on becomes original plus proposed (an id the answer drops
  # is kept, and said), in place under the same id, with a paragraph the host writes from ids alone; a task with a prerequisite nobody
  # supplies, a contradiction, an ambiguity, a blank human input, or a supplier that is no earlier or archived task, is held: held/<id>.json
  # (the file as it was), held/<id>.reason, held/<id>.proposed.json (for the operator; nothing here applies it). No model text enters a queued
  # task and Goal, Scope, Done when and Out of scope are never touched: under the merge gate the base is next, which agents wrote and no
  # human read, so its text can steer this session, and a delay or a hold is the only output that cannot become authority. The proposed
  # queue goes through the deterministic lint whole and is applied, or nothing is. Exit 0 when applied (holds listed, and in the manifest's
  # deep_lint); any other exit changed nothing, unless the manifest says deep_lint.result "applying" (it died between the renames), and
  # `batch` then runs on the deterministic lint.
  dir="${1:-$QUEUE}"; [ -d "$dir" ] || die "no such queue: $dir"; dir=$(cd "$dir" && pwd)   # absolute: it is mounted
  set -- "$dir"/*.json; [ -e "$1" ] || { echo "deep lint: no task files in $dir"; return 0; }; ntasks=$#
  out=$(cmd_lint "$dir") || die "the queue fails lint; deep lint reads only a queue that passes it:"$'\n'"$out"
  [ "$(jq -r .repo "$dir"/*.json | sort -u | wc -l)" -eq 1 ] || die "deep lint reads one base; this queue targets more than one repo"
  repo_norm "$(jq -r .repo "$1")" || die "repo must be owner/name, a GitHub URL, another https URL, or a local path"
  # ponytail: one base per queue (a declared factory/<id> base builds on an earlier task, which the prompt covers); one container per base if a queue mixes them
  base=$(jq -r 'select(.base_branch|startswith("factory/")|not) | .base_branch' "$dir"/*.json | sort -u)
  [ -n "$base" ] && [[ "$base" != *$'\n'* ]] || die "deep lint reads one base; this queue has $(printf '%s' "$base" | grep -c .) base branches"
