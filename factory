HALT="$FACTORY_DIR/HALT"    # written by `factory stop`; blocks dispatch until a human removes it
IMAGE="factory-sandbox"
# The image this factory commit was reviewed with: the local image config ID (`docker image inspect --format '{{.Id}}'`), not a registry
# digest. A run refuses to start on any other image. Rollout is two steps: merge the code, pull, build, read the ID, merge a one-line
# PR bumping this, pull again. FACTORY_ALLOW_DIRTY=1 runs on any image and the manifest says so (image_pinned:false).
IMAGE_ID="sha256:ccb8a02a58d960fe5eeb66449d34856eb086fef6d8fcddd87651dad5a0136313"
