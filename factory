    [ "$(jq '.drop|length' <<< "$d")" -eq 0 ] || refused=$(jq -c --arg id "$id" --argjson x "$(jq -c .drop <<< "$d")" '. + [{task_id:$id, dropped:$x}]' <<< "$refused")
    known="$known$(base_id "$id") "
  done
  if ! out=$(cmd_lint "$stage" 2>&1); then
    manifest_set '.deep_lint = {result:"refused", lint:$l}' --arg l "${out:0:4000}"; log "the proposed queue fails lint; nothing changed. ${out:0:2000}"
    echo "deep lint: the proposed queue fails lint; nothing changed:"; printf '%s\n' "$out"; exit 6
  fi
  # Applied: holds first (the held files, then the queue file goes), then the additions, with INT and TERM ignored for the renames, so a stop
  # leaves the queue as it was or as answered (HALT still stops the batch). The manifest says "applying" (with the plan) before the first
  # rename and "applied" as the last step, so an exit in between is told apart from one that changed nothing: the batch reports it as a
  # queue that may be partly changed. ponytail: one rename per file and an honest record, not a rollback; every partial state passes lint
  # (each change stands alone), and a hold left undone is held again at the next deep lint.
  manifest_set '.deep_lint = {result:"applying", added:$a, held:$h, refused:$r, revised:$v}' --argjson a "$added" --argjson h "$held" --argjson r "$refused" --argjson v "$revised"
  trap '' INT TERM; mkdir -p "$dir/held"
  for id in $(jq -r '.[].task_id' <<< "$held"); do mv "$stage/held/$id.json" "$stage/held/$id.reason" "$stage/held/$id.proposed.json" "$dir/held/"; rm -f "${dir:?}/${id:?}.json"; done
  for id in $(jq -r '.[].task_id' <<< "$added"); do mv "$stage/$id.json" "$dir/$id.json"; done
