FACTORY_DIR="$(cd "$(dirname "$0")" && pwd)"
RUNS="$FACTORY_DIR/runs"
QUEUE="${FACTORY_QUEUE:-$FACTORY_DIR/queue}"   # task files; lint and batch read it by default (override for tests or a second queue)
