#!/bin/bash
# factory: orchestrator for the software factory. See factory.md.
#   factory run <task-file>   validate job, mint run, docker run the sandbox, write manifest + log
#   factory lint [dir]        check queue/*.json against the task rules in README.md before a batch
#   factory lint --deep [dir] one Codex session reads the queue and its base: adds the depends_on a task lacks, holds what cannot pass (held/)
#   factory batch [dir] [--max-tasks N] [--stop-at HH:MM] [--no-chain] [--continue]
#                             the overnight queue: each task bases on the previous task's branch; stops on the first failure
#   factory report [n]        one line per run from the manifests: exit, judge rounds, verdict, PR
#   factory requeue <file>    copy a task from queue/failed/ back into the queue as <id>-r<N>, with the last attempt's findings
#   factory unhold <file>     move a held task (queue/held/<id>.json or its .proposed.json) back into the queue under its own id
#   factory stop <run_id>     kill the container, block new dispatch, record the incident
#   factory ruleset-check <owner/name>  the negative tests of a target repo's rulesets with real tokens (run by hand; see factory.md)
# Compatible with the macOS /bin/bash (3.2). Needs: docker, git, jq.
set -euo pipefail
export LC_ALL=C   # task-id order is the batch's schedule and must not depend on the operator's locale
# Docker Desktop keeps its CLI inside the app bundle unless the /usr/local/bin symlinks were installed.
